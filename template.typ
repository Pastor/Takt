// ─── Шаблон научной статьи ──────────────────────────────────────────────────
// Конвертировано из .temp/SHablon.docx

#let article(
  edn: "",
  title-ru: [],
  title-en: [],
  authors-ru: [],
  authors-en: [],
  affiliation-ru: [],
  affiliation-en: [],
  abstract-ru: [],
  abstract-en: [],
  keywords-ru: [],
  keywords-en: [],
  body,
) = {
  set page(
    paper: "a4",
    margin: (top: 1cm, bottom: 1cm, left: 2cm, right: 1cm),
    numbering: "1",
    number-align: center,
  )
  set text(
    lang: "ru",
    font: ("Times New Roman", "Liberation Serif", "DejaVu Serif"),
    size: 14pt,
  )
  set par(justify: true, leading: 0.65em, first-line-indent: 1cm)
  set heading(numbering: none)

  show heading.where(level: 1): it => {
    v(0.8em, weak: true)
    align(center, text(size: 14pt, weight: "bold", it.body))
    v(0.4em, weak: true)
  }
  show heading.where(level: 2): it => {
    v(0.6em, weak: true)
    text(size: 14pt, weight: "bold", it.body)
    v(0.3em, weak: true)
  }

  show figure.caption: set text(size: 12pt)

  // ─── Шапка статьи ──────────────────────────────────────────────────────────
  {
    set par(first-line-indent: 0pt, justify: true)

    if edn != "" {
      text(size: 12pt)[EDN: #edn]
      v(0.6em)
    }

    align(center,
      text(
        size: 17pt,
        weight: "bold",
        font: ("Calibri", "Arial", "Liberation Sans"),
        title-ru,
      )
    )
    v(0.4em)
    align(center, text(size: 12pt, authors-ru))
    v(0.15em)
    align(center, text(size: 10pt, style: "italic", affiliation-ru))
    v(0.6em)

    text(size: 12pt, weight: "bold")[Аннотация]
    linebreak()
    text(size: 12pt, abstract-ru)
    v(0.2em)
    text(size: 12pt)[*Ключевые слова:* #keywords-ru]

    v(1.4em)

    align(center,
      text(
        size: 17pt,
        weight: "bold",
        font: ("Calibri", "Arial", "Liberation Sans"),
        title-en,
      )
    )
    v(0.4em)
    align(center, text(size: 12pt, authors-en))
    v(0.15em)
    align(center, text(size: 10pt, style: "italic", affiliation-en))
    v(0.6em)

    text(size: 12pt, weight: "bold")[Abstract]
    linebreak()
    text(size: 12pt, abstract-en)
    v(0.2em)
    text(size: 12pt)[*Keywords:* #keywords-en]

    v(1.4em)
  }

  body
}

