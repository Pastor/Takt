<idea-plugin>
    <id>org.lam.intellij</id>
    <name>Lam</name>
    <vendor url="https://github.com/Pastor/BuT">Lam</vendor>

    <description><![CDATA[
        Lam (Language of Automata Models) language support for IntelliJ IDEA:
        <code>.lam</code> file type, syntax highlighting, go to declaration and
        <code>import</code> navigation.<br/>
        <br/>
        Поддержка языка <b>Lam</b> (Language of Automata Models) в IntelliJ IDEA:
        распознавание файлов <code>.lam</code>, подсветка синтаксиса, переход к
        декларации и навигация по директивам <code>import</code>. Базовая
        подсветка лексическая (работает офлайн, в т.ч. в Community).
    ]]></description>

    <!-- Диапазон совместимости IDE (sinceBuild/untilBuild) патчится Gradle-плагином
         из gradle.properties — здесь не дублируется (ADR 0022). -->

    <depends>com.intellij.modules.platform</depends>

    <!-- 0038: опциональная интеграция LSP4IJ (семантическая подсветка через
         lam-lsp). Без установленного LSP4IJ плагин грузится и работает как
         лексический (0022) — отсутствие зависимости не срывает загрузку. -->
    <depends optional="true" config-file="lam-lsp4ij.xml">com.redhat.devtools.lsp4ij</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 0038: настройки LSP-слоя (путь к `lam-lsp`). Класс не зависит от
             LSP4IJ, поэтому сервис регистрируется всегда (не в опциональном
             config-file) — путь можно хранить независимо от наличия LSP4IJ. -->
        <applicationService serviceImplementation="org.lam.intellij.lsp.LamLspSettings"/>

        <!-- 0022-01: регистрация типа файла `.lam` → язык Lam (R1, A1). -->
        <fileType
                name="Lam"
                implementationClass="org.lam.intellij.LamFileType"
                fieldName="INSTANCE"
                language="Lam"
                extensions="lam"/>

        <!-- 0022-02: лексическая подсветка синтаксиса. -->
        <lang.syntaxHighlighterFactory
                language="Lam"
                implementationClass="org.lam.intellij.highlight.LamSyntaxHighlighterFactory"/>

        <!-- 0022-03: страница настройки цветов, commenter, brace matcher. -->
        <colorSettingsPage implementation="org.lam.intellij.highlight.LamColorSettingsPage"/>
        <lang.commenter language="Lam" implementationClass="org.lam.intellij.editor.LamCommenter"/>
        <lang.braceMatcher language="Lam" implementationClass="org.lam.intellij.editor.LamBraceMatcher"/>

        <!-- 0023: плоский PSI-разбор — даёт реальные PsiElement под кареткой
             (нужны навигации и ссылкам; ADR 0023, Option A). -->
        <lang.parserDefinition
                language="Lam"
                implementationClass="org.lam.intellij.parser.LamParserDefinition"/>

        <!-- 0023: переход к декларации (Go to Declaration) и к файлам `import`. -->
        <gotoDeclarationHandler
                implementation="org.lam.intellij.navigation.LamGotoDeclarationHandler"/>
    </extensions>
</idea-plugin>
