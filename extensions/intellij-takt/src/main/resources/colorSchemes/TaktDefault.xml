<!--
  Значения по умолчанию для СЕМАНТИЧЕСКИХ ключей Takt в светлых схемах
  (фикс 0196-01).

  Зачем файл существует. Ключ `TAKT_TYPE` наследует платформенный
  `CLASS_REFERENCE`, а тот в поставляемых схемах собственного цвета НЕ имеет —
  имя типа рисуется как обычный текст. Классификация при этом работает (сервер
  честно помечает `bit`, `u8`, `q(8, 8)` токеном `type`), но пользователь
  никакой разницы не видит, то есть фича 0196 закрыта наполовину.

  Задаётся только `TAKT_TYPE`: остальные семантические ключи наследуют
  категории, у которых цвет в схемах есть (`FUNCTION_DECLARATION`,
  `CLASS_NAME`, `STATIC_FIELD`) — переопределять их значило бы навязывать вкус
  там, где платформа уже решила.

  ⚠️ Это ЗНАЧЕНИЕ ПО УМОЛЧАНИЮ: пользовательская настройка цвета его
  перекрывает (Settings → Editor → Color Scheme → Takt).
-->
<scheme name="Default" version="142" parent_scheme="Default">
    <attributes>
        <option name="TAKT_TYPE">
            <value>
                <option name="FOREGROUND" value="1F7A6E"/>
            </value>
        </option>
    </attributes>
</scheme>
