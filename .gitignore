/.idea
# Cargo.lock ОТСЛЕЖИВАЕТСЯ (фича 0137): workspace содержит бинарники, а
# зависимость lalrpop берётся из git — без lock-файла сборка не воспроизводима.
/target
/.output.txt
/takt-lang/but/test_output.txt
.temporary
.syntx.json
output.txt
/takt-lang/.output/cmake-build-debug
/takt-lang/.output/.idea
extensions/zed-but/target
extensions/zed-but/Cargo.lock
extensions/zed-but/extension.wasm
/examples/example.pdf
/*.o

# Артефакты ручных проб (фича 0377): `rustc`/`cc`, запущенные без `--out-dir`,
# кладут вывод в ТЕКУЩИЙ каталог. Так в корень попали три `.rlib` (коммит
# 3c6bec19), и никто этого не заметил.
#
# ⚠️ Шаблоны НЕ якорятся корнем: текущим каталогом теста бывает и каталог
# крейта — так `libprobe.rlib` попал в `takt-lang/` (фича 0451). Сам запуск
# инструмента обязан задавать рабочий каталог, а это — вторая линия.
*.rlib
*.rmeta
*.so
/*.dylib
/takt-lang/.output
README.pdf
/*.svg
*.rs.orig
/takt-lang/*.svg
.temp
/cmake-build-debug
venv
.DS_Store
obj_dir

# Typst — каталог сборки документа описания языка (book/)
/book/book/

takt-lang/target

# Кэш байткода Python (документные гейты scripts/*.py)
__pycache__/
*.pyc

# Собранная статика редактора (фича 0531): производный каталог — копия
# `web/static` плюс модуль. В дерево не коммитится: артефакт, который никто не
# сверяет, протухает молча, а сверять его нечем — он равен своим исходникам по
# построению (`scripts/build-web.sh`).
/web/dist

# Каталог сборки сервера проектов (фича 0531, задача 09a). `web/server` —
# отдельный workspace, и корневой шаблон `/target` его не покрывает; гейт
# собирает в `target/web-server`, но `cargo` из каталога крейта положит сюда.
/web/server/target

# Хранилище исходников сервиса проектов и его копии (фича 0531, задача 09h):
# это ДАННЫЕ стенда, а не дерево проекта.
/web/projects/
/web/dumps/

# Окружение стенда: пароль базы и секрет подписи токенов (фича 0531).
/web/deploy/.env
