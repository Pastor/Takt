// 0041-07 (контрпример): порт-массив в цели st-at.
//
// Ожидается ST-004: локация IEC (%IX/%IB/%IW/…) адресует СКАЛЯР; у массива
// размера локации нет. Отказ обязан быть громким — молча разместить массив по
// адресу скаляра значило бы дать неверный адрес на стенде.

in arr: [u8; 4] := 0x300;

start Idle {
    always { arr[0] := arr[0]; }
}
