// 0041-02 (A5.2, R5.4): перечисление и структура.
//
// Перечисление НЕ становится перечислимым типом IEC: MatIEC отвергает явные
// значения вариантов (проба П4, задача 0041-06). Действует откат Option C —
// целочисленный тип плюс именованные константы `Floor_Bottom` / `Floor_Top`.
// Структура порождает `TYPE … STRUCT … END_STRUCT; END_TYPE`.

enum Floor { Bottom = 80, Top }

struct Coord {
    x: [bit;16],
    y: [bit;16]
}

var origin: Coord := 0;

cond AtOrigin = origin.x = 0;

start Idle {
    ref Done: AtOrigin;
}

state Done {}
