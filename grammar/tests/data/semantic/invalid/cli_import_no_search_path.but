// Контр-пример: импорт без указания пути поиска завершается ошибкой.
//
// Этот файл использует `import "std.but"`. Если не указать -I, компилятор
// выдаст ошибку: «Файл импорта не найден: std.but. Пути поиска: []»
//
// Демонстрация ошибки:
//   butc compile cli_import_no_search_path.but   # → ошибка!
//
// Правильный вызов:
//   butc compile -I grammar/tests/data/include cli_import_no_search_path.but

import "std.but";

var x: u8 = 0;
start S;
