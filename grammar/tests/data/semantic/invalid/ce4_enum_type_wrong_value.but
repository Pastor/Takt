// Ce4 + NI6: переменная с enum-типом, инициализирована недопустимым значением.
//
// Перечисление Color объявлено с вариантами Red=0, Green=1, Blue=2.
// Переменная c инициализирована значением 99, которое не является вариантом Color.
//
// Ожидаемое поведение: семантическая ошибка NI6:
// "переменная 'c' имеет тип 'Color', но инициализирована значением 99"

enum Color { Red = 0, Green = 1, Blue = 2 }
var c: Color = 99;
start S;
