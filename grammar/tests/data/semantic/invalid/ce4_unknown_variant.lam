// Ce4: Пример использования несуществующего варианта перечисления.
//
// В этом файле демонстрируется случай, когда переменная ссылается
// на несуществующий тип. В текущей реализации Ce4 это даст ошибку
// на этапе разрешения типа.
// Ожидается: ошибка семантики (неизвестный псевдоним типа).

type Color = [bit;8];
var state: Color = 0;
