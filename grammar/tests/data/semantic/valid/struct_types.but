// Примеры использования структурных типов в языке BuT.
//
// Структурные типы группируют поля в единый именованный тип.
// Поле структуры может иметь любой допустимый тип языка BuT.

// Определение структуры: координата 2D
struct Point {
    x: [bit;16],
    y: [bit;16]
}

// Определение структуры: простой флаговый тип
struct Flags {
    active: bit,
    ready: bit
}

// Переменная структурного типа
var origin: Point = 0;
var ctrl: Flags = 0;

// Конечный автомат с использованием структурных типов
start Idle {
    always {
        debug("структурные типы инициализированы");
    }
    ref Idle: ctrl.active = 0;
}
