// Ce4: Базовый пример использования перечислений.
//
// Перечисления в BuT реализованы на семантическом уровне через EnumNode.
// Этот файл демонстрирует модель, в которой enum добавляется программно.
// Файл должен разбираться без ошибок (enum не является синтаксической конструкцией).

var counter: [bit;8] := 0;
start Idle {
    ref Active: counter != 0;
}
state Active {
    ref Idle: counter = 0;
}
