// Пример: псевдонимы типов (семантически корректный).
//
// Демонстрирует объявление и использование псевдонимов типов:
// примитивных (bit, bool, float) и составных (массивы).

// Псевдоним для 8-битного беззнакового целого
type u8 = [bit; 8];

// Псевдоним для 16-битного беззнакового целого
type u16 = [bit; 16];

// Переменные с явными и псевдонимными типами
var raw_bit: bit       = false;
var raw_bool: bool     = false;
var raw_float: float   = 0;

var counter: u8        = 0;
var address: u16       = 0;

// Константа
const MAX: u8 = 255;

// Порт с адресом
port STATUS: u8 = 0x40000000;

// Состояние, использующее переменные
start Idle;
