// Пример документирования объектов BuT с помощью /// комментариев.
//
// LSP hover (C6) при наведении курсора на идентификатор должен
// отображать как сигнатуру, так и документацию.
//
// Формат hover-ответа:
//   ```but
//   <сигнатура>
//   ```
//
//   <документация>

/// Счётчик количества обработанных пакетов.
var packet_count: [bit;16] = 0;

/// Флаг готовности системы к работе.
var ready: bit = false;

/// Порог срабатывания таймера (в тактах).
const TIMEOUT: [bit;8] = 100;

/// Основное рабочее состояние автомата.
start Active {
    always {
        packet_count = packet_count + 1;
    }
    ref Idle: packet_count = 0;
}

/// Состояние ожидания (бездействия).
state Idle {
    ref Active: ready;
}
