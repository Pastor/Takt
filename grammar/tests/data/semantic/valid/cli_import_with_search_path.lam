// Пример: использование флага -I для поиска импортов.
//
// Этот файл использует `import "std.lam"` — стандартную библиотеку типов BuT.
// Для успешной компиляции необходимо указать путь к директории с std.lam через -I:
//
//   lamc compile -I grammar/tests/data/include cli_import_with_search_path.lam -o out/
//
// Без флага -I компиляция завершится ошибкой «файл импорта не найден».

import "std.lam";

/// Простой счётчик: стартует в Idle, переходит в Running.
model Counter {
    start Idle;
    state Running;
}

start Counter;
