// Примеры использования встроенных математических функций языка BuT.
//
// Встроенные функции min, max, abs доступны в любом контексте программы
// и работают с числовыми типами: bit, float, [bit;N].

// Переменные для демонстрации
var a: bit = true;
var b: bit = false;

// Вызов min: возвращает минимум двух значений
// min(a, b) → минимальное из a и b
var min_result: bit = min(a, b);

// Вызов max: возвращает максимум двух значений
// max(a, b) → максимальное из a и b
var max_result: bit = max(a, b);

// Вызов abs: возвращает абсолютное значение
// abs(x) → |x|
var abs_result: bit = abs(a);

// Конечный автомат с использованием встроенных функций
start Idle {
    always {
        // Применяем min/max для ограничения значений
        var lo: bit = min(a, b);
        var hi: bit = max(a, b);
        var magnitude: bit = abs(a);
        debug("вычисление завершено");
    }
    ref Idle: a = 0;
}
