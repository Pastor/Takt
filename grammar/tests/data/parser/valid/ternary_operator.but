// Примеры корректного использования тернарного оператора в языке BuT.
//
// ВАЖНО: Синтаксис `? :` в текущей грамматике BuT не поддерживается
// через парсер — узел Expression::ConditionalOperator создаётся напрямую
// в AST (например, через formula-блоки или внутренние преобразования).
//
// Данный файл демонстрирует семантически корректный BuT-код рядом
// с псевдокодом тернарного оператора для документирования намерения.

// Пример 1: переменная с булевым условием
// Эквивалент: var result = flag ? 1 : 0;
var flag: bit = true;
var result: bit = flag;      // пока — прямое присваивание

// Пример 2: переменная с числовым сравнением как условием
// Эквивалент: var y = x > 5 ? x : 5;
var x: [bit;8] = 10;
var y: [bit;8] = x;          // пока — прямое присваивание

// Пример 3: вложенный тернарный оператор
// Эквивалент: var z = a ? b ? 1 : 2 : 3;
var a: bit = true;
var b: bit = false;
var z: bit = a;              // пока — прямое присваивание

start S;
