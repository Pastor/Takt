// Все виды типов и объявлений переменных (позитивный тест)
// Демонстрирует: псевдонимы, константы, порты, переменные, массивы

// ── Псевдонимы типов ────────────────────────────────────────────────────────
type Flag   = bit;
type Byte   = [bit;8];
type Nibble = [bit;4];
type Word   = [Byte;2];

// ── Константы ───────────────────────────────────────────────────────────────
const MAX:   Byte = 0xFF;
const ZERO:  Flag = false;
const ONE:   Flag = true;
const HALF:  Byte = 0x80;

// ── Порты с адресами ─────────────────────────────────────────────────────────
port INPUT:    Byte = 0x00100000;
port OUTPUT:   Byte = 0x00200000;
port FLAG_BIT: Flag = 0x00300000;

// ── Переменные ───────────────────────────────────────────────────────────────
var x:   Byte = 0;
var y:   Flag = false;
var arr: [Byte;4] = { 0, 0, 0, 0 };

// ── Минимальная модель для корректности АСД ──────────────────────────────────
model M {
    start S;
}
