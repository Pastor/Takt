// Примеры корректного синтаксиса структурных типов `struct` в языке BuT.
//
// Структурный тип объединяет несколько именованных полей в один тип.
// Синтаксис: struct Имя { поле: Тип, ... }

// Пример 1: простая структура с полями разных типов
struct Point {
    x: [bit;16],
    y: [bit;16]
}

// Пример 2: структура с одним полем
struct Wrapper {
    value: bit
}

// Пример 3: структура с несколькими полями
struct Rect {
    origin_x: [bit;16],
    origin_y: [bit;16],
    width: [bit;16],
    height: [bit;16]
}

// Пример 4: переменная структурного типа
var w: Wrapper = 0;

start S;
