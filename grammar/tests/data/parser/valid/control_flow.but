// Управляющие конструкции (позитивный тест парсера)
// С1 (вариант A): все управляющие конструкции без скобок вокруг условия.
// Примечание: var-объявления внутри блоков операторов не поддерживаются грамматикой.
// Переменные объявляются на уровне состояния (state element), а не внутри блоков.
type u8 = [bit;8];

model M {
    // Переменные объявляются на уровне состояния
    var i: u8 = 0;
    var j: u8 = 0;
    start S {
        always {
            // Условный оператор (без скобок)
            if i = 0 {
                i = 1;
            }

            // if-else
            if i > 5 {
                i = 0;
            } else {
                i = i + 1;
            }

            // Цикл while — условие БЕЗ скобок (С1, вариант A)
            while i < 10 {
                i = i + 1;
            }

            // Цикл for — заголовок БЕЗ скобок (С1, вариант A)
            for i = 0; i < 10; i = i + 1 {
                j = j + i;
            }

            // Цикл do-while — условие БЕЗ скобок (С1, вариант A)
            do {
                i = i - 1;
            } while i > 0;
        }
    }
}
