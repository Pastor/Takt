// Управляющие конструкции (позитивный тест парсера)
// Примечание: var-объявления внутри блоков операторов не поддерживаются грамматикой.
// Переменные объявляются на уровне состояния (state element), а не внутри блоков.
type u8 = [bit;8];

model M {
    // Переменные объявляются на уровне состояния
    var i: u8 = 0;
    var j: u8 = 0;
    start S {
        var i: u8 = 0;
        var j: u8 = 0;
        always {
            // Условный оператор (без скобок в BuT)
            if i = 0 {
                i = 1;
            }

            // if-else
            if i > 5 {
                i = 0;
            } else {
                i = i + 1;
            }

            // Цикл while (условие БЕЗ скобок)
            while (i < 10) {
                i = i + 1;
            }

            // Цикл for (условие В скобках)
            for (i = 0; i < 10; i = i + 1) {
                j = j + i;
            }

            // Цикл do-while (условие В скобках)
            do {
                i = i - 1;
            } while (i > 0);
        }
    }
}
