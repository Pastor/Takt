// Контрпример: два оператора `next` в одном состоянии.
//
// Ошибка: `next` может быть объявлен не более одного раза в Implement-состоянии.
// Ожидаемая ошибка семантики: "Состояние 'A' уже содержит оператор next".

model M { start S; }

start A = M {
    next B;
    next C;   // повторный next — ошибка
}
state B;
state C;
