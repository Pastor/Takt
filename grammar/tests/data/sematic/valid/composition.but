// Пример: компоновка моделей (семантически корректный).
//
// Демонстрирует три вида компоновки:
//   sequential (+): модели выполняются последовательно;
//   parallel   (|): модели выполняются параллельно;
//   parenthesized: группировка для изменения порядка.

model Step1 {
    start A;
}

model Step2 {
    start B;
}

model Step3 {
    start C;
}

// Последовательная компоновка: сначала Step1, затем Step2
start Sequential = Step1 + Step2 { }
state SeqDone;

// Параллельная компоновка: Step1 и Step3 одновременно
start Parallel = Step1 | Step3 { }
state ParDone;

// Вложенная компоновка: (Step1 + Step2) | Step3
start Combined = (Step1 + Step2) | Step3 { }
state CombDone;
