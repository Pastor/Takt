// Пример: псевдонимы типов, переменные и порты.
//
// Проверяет:
// - объявление псевдонимов u8 и u16
// - переменная counter с типом u8
// - порт STATUS с аппаратным адресом

type u8  = [bit; 8];
type u16 = [bit; 16];

var   counter: u8  = 0;
port  STATUS:  u8  = 0x40000000;

start Idle {
    ref Done: true;
}
state Done;
