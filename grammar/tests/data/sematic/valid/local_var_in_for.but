// Пример С4: var в инициализаторе for, переменная видна в условии и шаге.
//
// Проверяет: переменная, объявленная в for-init, доступна в условии,
// шаге и теле цикла.

var result: bit = false;

start S {
    always {
        for var i: bit = false; i; i = false {
            result = i;
        }
    }
}
