use super::parser::ast::*;
use super::diagnostics::Location;
use super::parser::lexer::{Token, LexicalError};
use super::parser::parse_address_literal;
use lalrpop_util::ErrorRecovery;
grammar<'input, 'err>(input: &'input str, file_no: u64 , parser_errors: &'err mut Vec<ErrorRecovery<usize, Token<'input>, LexicalError>> );

pub SourceUnit: Model = {
    <l:@L> <elements:(<ModelElement>)*> <r:@R> => Model{loc: Location::Source(file_no, l, r), name: None, elements, implements: None},
}

ImportPath: ImportPath = {
    StringLiteral => ImportPath::Filename(<>),
    ButIdentifierPath => ImportPath::Path(<>),
}

Import: ModelElement = {
    <l:@L> "import" <s:ImportPath> <r:@R> ";" => ModelElement::Import(ImportDefine::Plain(s, Location::Source(file_no, l, r))),
    <l:@L> "import" <s:ImportPath> "as" <id:Identifier> <r:@R> ";" => ModelElement::Import(ImportDefine::GlobalSymbol(s, id, Location::Source(file_no, l, r))),
    <l:@L> "import" "*" "as" <id:Identifier> "from" <s:ImportPath> <r:@R> ";" => {
        ModelElement::Import(ImportDefine::GlobalSymbol(s, id, Location::Source(file_no, l, r)))
    },
    <l:@L> "import" "{" <rename:CommaOne<ImportRename>> "}" "from" <s:ImportPath> <r:@R> ";" => {
        ModelElement::Import(ImportDefine::Rename(s,rename,Location::Source(file_no, l, r)))
    },
}

ImportRename: (Identifier, Option<Identifier>) = {
    <Identifier> => (<>, None),
    <from:Identifier> "as" <to:Identifier> => (from, Some(to)),
}

Model: Box<Model> = {
    <l:@L> "model" <name:IdentifierOrError> <implements: ("=" <Expression>)?>
    "{" <elements:(<ModelElement>)*> "}" <r:@R> => {
        Box::new(Model{loc: Location::Source(file_no, l, r), name, elements, implements})
    }
}
ModelElement: ModelElement = {
    Import => <>,
    TypeDefine => ModelElement::Type(<>),
    VariableDefine => ModelElement::Variable(<>),
    FunctionDefine => ModelElement::Function(<>),
    Model => ModelElement::Model(<>),
    StateDefine => ModelElement::State(<>),
    FormulaDefine=> ModelElement::Formula(<>),
    InlineFormulaDefine => ModelElement::InlineFormula(<>),
    ConditionDefine => ModelElement::Condition(Box::new(<>)),
    NamedBlockCodeDefine => ModelElement::NamedBlockCode(<>),
    <e:EnumDefine> => ModelElement::Enum(e),
    <s:StructDefine> => ModelElement::Struct(s),
    AddressDefine => ModelElement::Address(Box::new(<>)),
    <l:@L> ";" <r:@R> => ModelElement::StraySemicolon(Location::Source(file_no, l, r)),
}


StateKind: Option<StateKind> = {
    "state" => None,
    "start" => Some(StateKind::Start),
}
StateDefine: Box<StateDefine> = {
    <l:@L> <kind:StateKind> <name:IdentifierOrError> <implements: ("=" <Expression>)?>
    <elements:StateDefineEnd> <r:@R> => {
        Box::new(StateDefine{loc: Location::Source(file_no, l, r), name, elements, implements, kind})
    }
}

StateDefineEnd: Vec<StateElement> = {
    "{" <elements:(<StateElement>)*> "}" <r:@R> => {
        elements
    },
    ";" => Vec::new(),
}

StateElement: StateElement = {
    NamedBlockCodeDefine => StateElement::NamedBlockCode(<>),
    "next" <name:Identifier> ";" => StateElement::Next(name),
    <l:@L> "ref" <i:Identifier> <e: (":" <Condition>)?> ";" <r:@R> => StateElement::Reference(Location::Source(file_no, l, r), i, e),
    <l:@L> ";" <r:@R> => StateElement::StraySemicolon(Location::Source(file_no, l, r)),
    InlineFormulaDefine => StateElement::InlineFormula(<>),
}

ButIdentifierPath: IdentifierPath = {
    <l:@L> <e:Identifier> <v:(":" ":" <Identifier>)*> <r:@R> => {
        let mut v = v;
        v.insert(0, e);
        IdentifierPath { loc: Location::Source(file_no, l, r), identifiers: v }
    }
}

Identifier: Identifier = {
    <l:@L> <n:identifier> <r:@R> => Identifier{loc: Location::Source(file_no, l, r), name: n.to_string()},
    <l:@L> "X" <r:@R> => Identifier{loc: Location::Source(file_no, l, r), name: "X".to_string()},
    <l:@L> "F" <r:@R> => Identifier{loc: Location::Source(file_no, l, r), name: "F".to_string()},
    <l:@L> "G" <r:@R> => Identifier{loc: Location::Source(file_no, l, r), name: "G".to_string()},
    <l:@L> "U" <r:@R> => Identifier{loc: Location::Source(file_no, l, r), name: "U".to_string()},
    <l:@L> "R" <r:@R> => Identifier{loc: Location::Source(file_no, l, r), name: "R".to_string()},
    <l:@L> "LTL" <r:@R> => Identifier{loc: Location::Source(file_no, l, r), name: "LTL".to_string()},
    <l:@L> "Guard" <r:@R> => Identifier{loc: Location::Source(file_no, l, r), name: "Guard".to_string()},
}

IdentifierOrError: Option<Identifier> = {
    Identifier => Some(<>),
    ! => {
        parser_errors.push(<>);
        None
    }
}
ConditionDefine: ConditionDefine = {
    <l:@L> "cond" <name:IdentifierOrError> "=" <c:Condition> <r:@R> ";" => ConditionDefine {
        loc: Location::Source(file_no, l, r), name: name, value: c
    },
}

// Оператор задания адреса порта (фича 0020): `address Имя = <выражение>;`.
// Связка — `=` (как в определениях имён), значение — обычно литерал адреса
// `0xADDR` или `0xADDR:bit`. Привязка к порту и приоритет источников —
// семантика (0020-02).
AddressDefine: AddressDefine = {
    <l:@L> "address" <name:IdentifierOrError> "=" <e:Expression> <r:@R> ";" => AddressDefine {
        loc: Location::Source(file_no, l, r), name, value: e
    },
}

VariableDefine: Box<VariableDefine> = {
    <l:@L> "var" <name:IdentifierOrError> <typ:(":" <Type>)?> <e:(":=" <Expression>)?> <r:@R> ";" => {
        Box::new(VariableDefine::Variable {
            loc: Location::Source(file_no, l, r), typ, name, initializer: e
        })
    },
    <l:@L> "const" <name:IdentifierOrError> <typ:(":" <Type>)?> ":=" <e:Expression> <r:@R> ";" => {
        Box::new(VariableDefine::Constant {
            loc: Location::Source(file_no, l, r), typ, name, initializer: e
        })
    },
    <l:@L> "in" <name:IdentifierOrError> <typ:(":" <Type>)?> <e:(":=" <Expression>)?> <r:@R> ";" => {
        Box::new(VariableDefine::Port {
            loc: Location::Source(file_no, l, r), typ, name, initializer: e,
            direction: PortDirection::In,
        })
    },
    <l:@L> "out" <name:IdentifierOrError> <typ:(":" <Type>)?> <e:(":=" <Expression>)?> <r:@R> ";" => {
        Box::new(VariableDefine::Port {
            loc: Location::Source(file_no, l, r), typ, name, initializer: e,
            direction: PortDirection::Out,
        })
    },
    <l:@L> "inout" <name:IdentifierOrError> <typ:(":" <Type>)?> <e:(":=" <Expression>)?> <r:@R> ";" => {
        Box::new(VariableDefine::Port {
            loc: Location::Source(file_no, l, r), typ, name, initializer: e,
            direction: PortDirection::InOut,
        })
    },
}

// Объявление переменной/константы ВНУТРИ блока оператора.
//
// В отличие от VariableDefine, НЕ включает завершающий ";": он поставляется
// правилом NonIfStatement через <SimpleStatement> ";".
// port не поддерживается внутри блоков — порты являются аппаратными маппингами
// и объявляются только на уровне модели.
LocalVariableDefine: Box<VariableDefine> = {
    <l:@L> "var" <name:IdentifierOrError> <typ:(":" <Type>)?> <e:(":=" <Expression>)?> <r:@R> => {
        Box::new(VariableDefine::Variable {
            loc: Location::Source(file_no, l, r), typ, name, initializer: e
        })
    },
    <l:@L> "const" <name:IdentifierOrError> <typ:(":" <Type>)?> ":=" <e:Expression> <r:@R> => {
        Box::new(VariableDefine::Constant {
            loc: Location::Source(file_no, l, r), typ, name, initializer: e
        })
    },
}

FunctionCall: Expression = {
    <a:@L> <i:Identifier> "(" <v:Comma<Expression>> ")" <b:@R> => {
        Expression::Function(Location::Source(file_no, a, b), i, v)
    },
}

TypeDefine: Box<TypeDefine> = {
    <l:@L> "type" <name:Identifier> "=" <ty:Type> <r:@R> ";" => {
        Box::new(TypeDefine{
            loc: Location::Source(file_no, l, r), name, ty
        })
    },
}

EnumVariant: EnumVariant = {
    <l:@L> <name:Identifier> "=" <value:number> <r:@R> => EnumVariant {
        loc: Location::Source(file_no, l, r),
        name,
        value: Some(value),
    },
    <l:@L> <name:Identifier> <r:@R> => EnumVariant {
        loc: Location::Source(file_no, l, r),
        name,
        value: None,
    },
}

EnumDefine: Box<EnumDefine> = {
    <l:@L> "enum" <name:IdentifierOrError> "{" <variants:CommaOne<EnumVariant>> "}" <r:@R> => {
        Box::new(EnumDefine {
            loc: Location::Source(file_no, l, r),
            name,
            variants,
        })
    },
    <l:@L> "enum" <name:IdentifierOrError> "{" <false_token:!> "}" <r:@R> => {
        parser_errors.push(false_token);
        Box::new(EnumDefine {
            loc: Location::Source(file_no, l, r),
            name,
            variants: Vec::new(),
        })
    },
}

StructField: StructField = {
    <l:@L> <name:Identifier> ":" <ty:Type> <r:@R> => StructField {
        loc: Location::Source(file_no, l, r),
        name,
        ty,
    },
}

StructDefine: Box<StructDefine> = {
    <l:@L> "struct" <name:IdentifierOrError> "{" <fields:Comma<StructField>> "}" <r:@R> => {
        Box::new(StructDefine {
            loc: Location::Source(file_no, l, r),
            name,
            fields,
        })
    },
    <l:@L> "struct" <name:IdentifierOrError> "{" <false_token:!> "}" <r:@R> => {
        parser_errors.push(false_token);
        Box::new(StructDefine {
            loc: Location::Source(file_no, l, r),
            name,
            fields: Vec::new(),
        })
    },
}

BlockStatementOrSemiColon: Option<Statement> = {
    <@L> <@R> ";" => None,
    BlockStatement => Some(<>),
}

FunctionDefine: Box<FunctionDefine> = {
    <l:@L> <e: ("extern")?> "fn" <nl:@L> <name:IdentifierOrError> <nr:@R> <params:ParameterList>
    <return_type:("->" <Type>)?> <r:@R> <body:BlockStatementOrSemiColon> => {
        Box::new(FunctionDefine {
            loc: Location::Source(file_no, l, r),
            name,
            name_loc: Location::Source(file_no, nl, nr),
            params,
            return_type,
            body,
            external: e.is_some(),
        })
    },
}

NamedBlockCodeDefine: Box<NamedBlockCodeDefine> = {
    <l:@L> <name:IdentifierOrError> <statement:BlockStatement> <r:@R> => {
        Box::new(NamedBlockCodeDefine {
            loc: Location::Source(file_no, l, r),
            name,
            statement,
        })
    },
}

FormulaDefine: Box<FormulaDefine> = {
    <l:@L> "formula" <dialect:StringLiteral?> <block:FormulaBlock> <r:@R> => {
        Box::new(FormulaDefine {
            loc: Location::Source(file_no, l, r),
            formula: block
        })
    },
}

InlineFormulaDefine: Box<InlineFormulaDefine> = {
    <l:@L> ":" <conditions:CommaOne<Condition>> ";" <r:@R> => {
        Box::new(InlineFormulaDefine::Guard { loc: Location::Source(file_no, l, r), conditions })
    },
    <l:@L> ":" "[" "LTL" "]" <formulas:CommaOne<LtlExpr>> ";" <r:@R> => {
        Box::new(InlineFormulaDefine::Ltl { loc: Location::Source(file_no, l, r), formulas })
    },
    <l:@L> ":" "[" "Guard" "]" <conditions:CommaOne<Condition>> ";" <r:@R> => {
        Box::new(InlineFormulaDefine::Guard { loc: Location::Source(file_no, l, r), conditions })
    }
}

LtlExpr: LtlExpr = LtlImplies;

LtlImplies: LtlExpr = {
    <l_loc:@L> <l:LtlOr> "->" <r:LtlImplies> <r_loc:@R> => LtlExpr::Implies(Location::Source(file_no, l_loc, r_loc), Box::new(l), Box::new(r)),
    LtlOr
};

LtlOr: LtlExpr = {
    <l_loc:@L> <l:LtlOr> "|" <r:LtlAnd> <r_loc:@R> => LtlExpr::Or(Location::Source(file_no, l_loc, r_loc), Box::new(l), Box::new(r)),
    LtlAnd
};

LtlAnd: LtlExpr = {
    <l_loc:@L> <l:LtlAnd> "&" <r:LtlUntilRelease> <r_loc:@R> => LtlExpr::And(Location::Source(file_no, l_loc, r_loc), Box::new(l), Box::new(r)),
    LtlUntilRelease
};

LtlUntilRelease: LtlExpr = {
    <l_loc:@L> <l:LtlUntilRelease> "U" <r:LtlUnary> <r_loc:@R> => LtlExpr::Until(Location::Source(file_no, l_loc, r_loc), Box::new(l), Box::new(r)),
    <l_loc:@L> <l:LtlUntilRelease> "R" <r:LtlUnary> <r_loc:@R> => LtlExpr::Release(Location::Source(file_no, l_loc, r_loc), Box::new(l), Box::new(r)),
    LtlUnary
};

LtlUnary: LtlExpr = {
    <l:@L> "!" <e:LtlUnary> <r:@R> => LtlExpr::Not(Location::Source(file_no, l, r), Box::new(e)),
    <l:@L> "X" <e:LtlUnary> <r:@R> => LtlExpr::Next(Location::Source(file_no, l, r), Box::new(e)),
    <l:@L> "F" <e:LtlUnary> <r:@R> => LtlExpr::Finally(Location::Source(file_no, l, r), Box::new(e)),
    <l:@L> "G" <e:LtlUnary> <r:@R> => LtlExpr::Globally(Location::Source(file_no, l, r), Box::new(e)),
    LtlPrimary
};

LtlPrimary: LtlExpr = {
    <l:@L> "true" <r:@R> => LtlExpr::True(Location::Source(file_no, l, r)),
    <l:@L> "false" <r:@R> => LtlExpr::False(Location::Source(file_no, l, r)),
    <l:@L> <n:identifier> <r:@R> => LtlExpr::Atom(Identifier{loc: Location::Source(file_no, l, r), name: n.to_string()}),
    <l:@L> "(" <e:LtlExpr> ")" <r:@R> => LtlExpr::Parenthesis(Location::Source(file_no, l, r), Box::new(e)),
};

Type: Type = {
    <name:Identifier> => Type::Alias(name),
    <l:@L> "[" <ty:Type> ";" <n:number> "]" <r:@R> => {
        Type::Array {
            loc: Location::Source(file_no, l, r),
            element_count: n as u16,
            element_type: Box::new(ty)
        }
    }
}

Condition: Condition= {
    Condition6,
}

Condition6: Condition = {
    <a:@L> <l:Condition6> "|" <r:Condition5> <b:@R> => Condition::Or(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    Condition5,
}

Condition5: Condition = {
    <a:@L> <l:Condition5> "&" <r:Condition4> <b:@R> => Condition::And(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    Condition4,
}

Condition4: Condition = {
    <a:@L> <l:Condition4> "=" <r:Condition3> <b:@R> => Condition::Equal(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    <a:@L> <l:Condition4> "!=" <r:Condition3> <b:@R> => Condition::NotEqual(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    Condition3,
}

Condition3: Condition = {
    <a:@L> <l:Condition3> "<" <r:Condition2> <b:@R> => Condition::Less(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    <a:@L> <l:Condition3> ">" <r:Condition2> <b:@R> => Condition::More(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    <a:@L> <l:Condition3> "<=" <r:Condition2> <b:@R> => Condition::LessEqual(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    <a:@L> <l:Condition3> ">=" <r:Condition2> <b:@R> => Condition::MoreEqual(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    Condition2,
}

Condition2: Condition = {
    <a:@L> <l:Condition2> "+" <r:Condition1> <b:@R> => Condition::Add(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    <a:@L> <l:Condition2> "-" <r:Condition1> <b:@R> => Condition::Subtract(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    Condition1,
}

Condition1: Condition = {
    <a:@L> "!" <e:Condition1> <b:@R> => Condition::Not(Location::Source(file_no, a, b), Box::new(e)),
    Condition0
}

Condition0: Condition = {
  <Identifier> => Condition::Variable(<>),
  <a:@L> <i:Identifier> "(" <v:Comma<Condition>> ")" <b:@R> => {
      Condition::Function(Location::Source(file_no, a, b), i, v)
  },
  <a:@L> "(" <e:Condition> ")" <b:@R> => Condition::Parenthesis(Location::Source(file_no, a, b), Box::new(e)),
  <a:@L> <e:Condition0> "." <i:Member> <b:@R> => Condition::BitAccess(Location::Source(file_no, a, b), Box::new(e), i),
  <a:@L> <i:Identifier> "[" <n:number> "]" <b:@R> => Condition::ArraySubscript(Location::Source(file_no, a, b), i, Box::new(Condition::Number(Location::Source(file_no, a, b), n))),
  <a:@L> <i:Identifier> "[" <idx:Identifier> "]" <b:@R> => Condition::ArraySubscript(Location::Source(file_no, a, b), i, Box::new(Condition::Variable(idx))),
  ConditionExpression,
}

ConditionExpression: Condition = {
    <a:@L> "true" <b:@R> => Condition::Bool(Location::Source(file_no, a, b), true),
    <a:@L> "false" <b:@R> => Condition::Bool(Location::Source(file_no, a, b), false),
    <l:@L> <n:number> <r:@R> => {
        Condition::Number(Location::Source(file_no, l, r), n)
    },
    <l:@L> <n:rational> <r:@R> => {
        Condition::Rational(Location::Source(file_no, l, r), n.0.to_string(), n.1)
    },
}

Member: Member = {
    <Identifier> => Member::Identifier(<>),
    <number> => Member::Number(<>)
}

// LoopCond: условие цикла `loop` — та же цепочка, но с атомом без ведущей `{`.
// Дубликат `LoopCondP14…LoopCondP1` (96 строк) устранён задачей 0019-01.
LoopCond: Expression = { Chain14<Precedence1NoBrace> }

Expression: Expression = {
    Chain14<Precedence1Full>
}

// ─────────────────────────────────────────────────────────────────────────────
// Chain<Atom> — цепочка приоритетов выражений, параметризованная атомом.
//
// Задача 0019-01 (ADR 0019, Option B): раньше цепочка существовала ДВАЖДЫ —
// `Precedence14…Precedence1` и её почти дословная копия `LoopCondP14…LoopCondP1`.
// Копии отличались ровно одним: атом loop-условия не может начинаться с `{`
// (иначе LR(1)-неоднозначность между `loop { body }` и `loop {init} { body }`).
//
// Теперь цепочка написана ОДИН раз и инстанцируется двумя атомами:
//   Expression = Chain14<Precedence1Full>     — атом с инициализатором `{…}`
//   LoopCond   = Chain14<Precedence1NoBrace>  — атом без него
//
// ВАЖНО: ограничение касается только ПЕРВОГО токена, поэтому ПРАВЫЙ операнд
// любого бинарного оператора — всегда полная цепочка `Chain*<Precedence1Full>`.
// Это в точности повторяет прежнее поведение LoopCondP*, где справа стоял
// `PrecedenceN`.
//
// Разделение `Condition` и `Expression` НЕ унифицируется: оно намеренное —
// `=` в условии означает равенство, а в выражении присваивание (ADR 0019).
// ─────────────────────────────────────────────────────────────────────────────

Chain14<Atom>: Expression = {
    <a:@L> <l:Chain13<Atom>> ":=" <r:Chain14<Precedence1Full>> <b:@R> => Expression::Assign(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    // Тернарный оператор: cond ? then : else (правоассоциативный, ниже присваивания)
    <a:@L> <c:Chain13<Atom>> "?" <t:Chain14<Precedence1Full>> ":" <e:Chain14<Precedence1Full>> <b:@R> => Expression::ConditionalOperator(Location::Source(file_no, a, b), Box::new(c), Box::new(t), Box::new(e)),
    Chain13<Atom>,
}

Chain13<Atom>: Expression = {
    <a:@L> <l:Chain13<Atom>> "||" <r:Chain12<Precedence1Full>> <b:@R> => Expression::Or(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    Chain12<Atom>,
}

Chain12<Atom>: Expression = {
    <a:@L> <l:Chain12<Atom>> "&&" <r:Chain11<Precedence1Full>> <b:@R> => Expression::And(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    Chain11<Atom>,
}

Chain11<Atom>: Expression = {
    <a:@L> <l:Chain11<Atom>> "=" <r:Chain10<Precedence1Full>> <b:@R> => Expression::Equal(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    <a:@L> <l:Chain11<Atom>> "!=" <r:Chain10<Precedence1Full>> <b:@R> => Expression::NotEqual(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    Chain10<Atom>,
}

Chain10<Atom>: Expression = {
    <a:@L> <l:Chain10<Atom>> "<" <r:Chain9<Precedence1Full>> <b:@R> => Expression::Less(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    <a:@L> <l:Chain10<Atom>> ">" <r:Chain9<Precedence1Full>> <b:@R> => Expression::More(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    <a:@L> <l:Chain10<Atom>> "<=" <r:Chain9<Precedence1Full>> <b:@R> => Expression::LessEqual(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    <a:@L> <l:Chain10<Atom>> ">=" <r:Chain9<Precedence1Full>> <b:@R> => Expression::MoreEqual(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    Chain9<Atom>,
}

Chain9<Atom>: Expression = {
    <a:@L> <l:Chain9<Atom>> "|" <r:Chain8<Precedence1Full>> <b:@R> => Expression::BitwiseOr(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    Chain8<Atom>,
}

Chain8<Atom>: Expression = {
    <a:@L> <l:Chain8<Atom>> "^" <r:Chain7<Precedence1Full>> <b:@R> => Expression::BitwiseXor(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    Chain7<Atom>,
}

Chain7<Atom>: Expression = {
    <a:@L> <l:Chain7<Atom>> "&" <r:Chain6<Precedence1Full>> <b:@R> => Expression::BitwiseAnd(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    <a:@L> <e:Chain7<Atom>> "as" <ty:Type> <b:@R> => Expression::Cast(Location::Source(file_no, a, b), Box::new(e), ty),
    Chain6<Atom>,
}

Chain6<Atom>: Expression = {
    <a:@L> <l:Chain6<Atom>> "<<" <r:Chain5<Precedence1Full>> <b:@R> => Expression::ShiftLeft(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    <a:@L> <l:Chain6<Atom>> ">>" <r:Chain5<Precedence1Full>> <b:@R> => Expression::ShiftRight(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    Chain5<Atom>,
}

Chain5<Atom>: Expression = {
    <a:@L> <l:Chain5<Atom>> "+" <r:Chain4<Precedence1Full>> <b:@R> => Expression::Add(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    <a:@L> <l:Chain5<Atom>> "-" <r:Chain4<Precedence1Full>> <b:@R> => Expression::Subtract(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    Chain4<Atom>,
}

Chain4<Atom>: Expression = {
    <a:@L> <l:Chain4<Atom>> "*" <r:Chain3<Precedence1Full>> <b:@R> => Expression::Multiply(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    <a:@L> <l:Chain4<Atom>> "/" <r:Chain3<Precedence1Full>> <b:@R> => Expression::Divide(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    <a:@L> <l:Chain4<Atom>> "%" <r:Chain3<Precedence1Full>> <b:@R> => Expression::Modulo(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    Chain3<Atom>,
}

Chain3<Atom>: Expression = {
    <a:@L> <l:Chain2<Atom>> "**" <r:Chain3<Precedence1Full>> <b:@R> => Expression::Power(Location::Source(file_no, a, b), Box::new(l), Box::new(r)),
    Chain2<Atom>,
}

Chain2<Atom>: Expression = {
    <a:@L> "!" <e:Chain2<Atom>> <b:@R> => Expression::Not(Location::Source(file_no, a, b), Box::new(e)),
    <a:@L> "~" <e:Chain2<Atom>> <b:@R> => Expression::BitwiseNot(Location::Source(file_no, a, b), Box::new(e)),
    <a:@L> "+" <e:Chain2<Atom>> <b:@R>  => Expression::UnaryPlus(Location::Source(file_no, a, b), Box::new(e)),
    <a:@L> "-" <e:Chain2<Atom>> <b:@R> => Expression::Negate(Location::Source(file_no, a, b), Box::new(e)),
    Atom,
}

Precedence1Full: Expression = {
    // Адресный литерал `0xNNNN:bit` — единый токен (без LR-конфликта с тернарным `?:`)
    <l:@L> <a:address> <r:@R> => {
        let (addr_val, bit_val) = parse_address_literal(a);
        Expression::Address(Location::Source(file_no, l, r), addr_val, bit_val)
    },
    <l:@L> <n:number> <r:@R> => {
        Expression::Number(Location::Source(file_no, l, r), n)
    },
    <l:@L> <n:rational> <r:@R> => {
        Expression::Rational(Location::Source(file_no, l, r), n.0.to_string(), n.1)
    },
    <l:@L> "{" <v:CommaOne<Expression>> "}" <r:@R> => {
        Expression::Initializer(Location::Source(file_no, l, r), v)
    },
    Precedence0
}

Precedence1NoBrace: Expression = {
    // Адресный литерал `0xNNNN:bit` — единый токен (без LR-конфликта с тернарным `?:`)
    <l:@L> <a:address> <r:@R> => {
        let (addr_val, bit_val) = parse_address_literal(a);
        Expression::Address(Location::Source(file_no, l, r), addr_val, bit_val)
    },
    <l:@L> <n:number> <r:@R> => {
        Expression::Number(Location::Source(file_no, l, r), n)
    },
    <l:@L> <n:rational> <r:@R> => {
        Expression::Rational(Location::Source(file_no, l, r), n.0.to_string(), n.1)
    },
    // Инициализатор массива `{…}` намеренно отсутствует: в loop-условии
    // ведущая `{` всегда начинает тело цикла. Для инициализатора — скобки:
    // `loop ({1, 2}) { body }`.
    Precedence0
}

Precedence0: Expression = {
   <Identifier> => Expression::Variable(<>),
   <FunctionCall> => <>,
   <l:@L> <a:ParameterList> <r:@R> => {
      if a.len() == 1 {
          if let Some(Parameter{ ty, name: None, .. }) = &a[0].1 {
              // this means "(" Expression ")"
              return Expression::Parenthesis(ty.loc(), Box::new(ty.clone()));
          }
      }

      Expression::List(Location::Source(file_no, l, r), a)
  },
  <a:@L> <e:Precedence0> "." <i:Member> <b:@R> => Expression::BitAccess(Location::Source(file_no, a, b), Box::new(e), i),
  <a:@L> <i:Identifier> "[" <n:number> "]" <b:@R> => Expression::ArraySubscript(Location::Source(file_no, a, b), i, Box::new(Expression::Number(Location::Source(file_no, a, b), n))),
  <a:@L> <i:Identifier> "[" <idx:Identifier> "]" <b:@R> => Expression::ArraySubscript(Location::Source(file_no, a, b), i, Box::new(Expression::Variable(idx))),
  <a:@L> <i:Identifier> "[" <l:number?> ":" <r:number?> "]" <b:@R> => Expression::ArraySlice(Location::Source(file_no, a, b), i, l, r),
  LiteralExpression,
}

/// Выражение типа для использования в позиции параметра функции.
///
/// FE6: Позволяет использовать составные типы `[bit;N]` в позиции
/// параметра функции: `fn process(data: [bit;8])`.
ParameterTypeExpr: Expression = {
    // Составной тип [тип;N] → Expression::Type(loc, Type::Array)
    <l:@L> "[" <ty:Type> ";" <n:number> "]" <r:@R> => {
        Expression::Type(
            Location::Source(file_no, l, r),
            Type::Array {
                loc: Location::Source(file_no, l, r),
                element_count: n as u16,
                element_type: Box::new(ty),
            }
        )
    },
    Expression => <>,
}

Parameter: Parameter = {
    <l:@L> <name:Identifier> ":" <ty:ParameterTypeExpr> <r:@R> => {
        let loc = Location::Source(file_no, l, r);
        Parameter{loc, ty, name: Some(name)}
    },
    <l:@L> <ty:ParameterTypeExpr> <r:@R> => {
        let loc = Location::Source(file_no, l, r);
        Parameter{loc, ty: ty, name: None}
    }
}

OptParameter: (Location, Option<Parameter>) = {
    <l:@L> <p:Parameter?> <r:@R> => (Location::Source(file_no, l, r), p),
}

ParameterList: Vec<(Location, Option<Parameter>)> = {
    "(" ")" => Vec::new(),
    "(" <l:@L> <p:Parameter> <r:@R> ")" => vec!((Location::Source(file_no, l, r), Some(p))),
    "(" <CommaTwo<OptParameter>> ")" => <>,
    "(" <false_token:!> ")"=> {
        parser_errors.push(<>);
        Vec::new()
    }
}
LiteralExpression: Expression = {
    <a:@L> "true" <b:@R> => Expression::Bool(Location::Source(file_no, a, b), true),
    <a:@L> "false" <b:@R> => Expression::Bool(Location::Source(file_no, a, b), false),
    <StringLiteral+> => Expression::String(<>),
}

BlockStatement: Statement = {
    <l:@L> "{" <statements:Statement*> "}" <r:@R> => {
        Statement::Block { loc: Location::Source(file_no, l, r), unchecked: false, statements }
    },
}

OpenStatement: Statement = {
    <l:@L> "if" <cond:Expression> <body:BlockStatement> <r:@R> => {
        Statement::If(Location::Source(file_no, l, r), cond, Box::new(body), None)
    },
    <l:@L> "if" <cond:Expression> <body:BlockStatement> "else" <o:OpenStatement> <r:@R> => {
        Statement::If(Location::Source(file_no, l, r), cond, Box::new(body), Some(Box::new(o)))
    },
    // С1 (вариант A): while/for не могут быть OpenStatement, так как их тело — всегда
    // BlockStatement (закрытый). OpenStatement содержит только незакрытые if-цепочки.
}

ClosedStatement: Statement = {
    NonIfStatement,
    <l:@L> "if" <cond:Expression> <body:BlockStatement> "else" <o:ClosedStatement> <r:@R> => {
        Statement::If(Location::Source(file_no, l, r), cond, Box::new(body), Some(Box::new(o)))
    },
    // Цикл loop без условия (бесконечный): loop { тело }
    // '{' безусловно начинает тело — неоднозначности нет
    <l:@L> "loop" <b:BlockStatement> <r:@R> => {
        Statement::Loop(Location::Source(file_no, l, r), None, Box::new(b))
    },
    // Цикл loop с условием: loop условие { тело }
    // LoopCond не начинается с '{', что устраняет LR(1)-конфликт с BlockStatement
    <l:@L> "loop" <e:LoopCond> <b:BlockStatement> <r:@R> => {
        Statement::Loop(Location::Source(file_no, l, r), Some(e), Box::new(b))
    },
    // `while условие { тело }` — синоним `loop условие { тело }`
    <l:@L> "while" <e:LoopCond> <b:BlockStatement> <r:@R> => {
        Statement::Loop(Location::Source(file_no, l, r), Some(e), Box::new(b))
    },
    // С1 (вариант A): for без скобок вокруг заголовка; тело — обязательный блок в {}.
    <l:@L> "for" <b:SimpleStatement?> ";" <c:Expression?> ";" <n:Expression?> <block:BlockStatement> <r:@R> => {
        Statement::For(Location::Source(file_no, l, r), b.map(Box::new), c.map(Box::new), n.map(Box::new), Some(Box::new(block)))
    },
    // С1 (вариант A): for без тела (пустой цикл с завершающей ';')
    <l:@L> "for" <b:SimpleStatement?> ";" <c:Expression?> ";" <n:Expression?> <r:@R> ";" => {
        Statement::For(Location::Source(file_no, l, r), b.map(Box::new), c.map(Box::new), n.map(Box::new), None)
    }
}

// Образец в ветке match: конкретное значение или `_` (wildcard).
MatchPattern: MatchPattern = {
    <l:@L> "_" <r:@R> => MatchPattern::Wildcard(Location::Source(file_no, l, r)),
    <e:LoopCond> => MatchPattern::Value(e),
}

// Одна ветка match: `образец (, образец)* => { тело }`.
MatchArm: MatchArm = {
    <l:@L> <pats:CommaOne<MatchPattern>> "=>" <body:BlockStatement> <r:@R> => MatchArm {
        loc: Location::Source(file_no, l, r),
        patterns: pats,
        body: Box::new(body),
    },
}

Statement: Statement = {
    OpenStatement,
    ClosedStatement,
    // Оператор match: `match выражение { ветки }`.
    <l:@L> "match" <e:LoopCond> "{" <arms:MatchArm*> "}" <r:@R> => {
        Statement::Match(Location::Source(file_no, l, r), Box::new(e), arms)
    },
    <l:@L> <false_token:!> <r:@R> => {
        parser_errors.push(false_token);
        Statement::Error(Location::Source(file_no, l, r))
    },
}

SimpleStatement: Statement = {
    // С4: var/const внутри блока — LocalVariableDefine не включает ";",
    // который добавляет NonIfStatement через <SimpleStatement> ";".
    <l:@L> <v:LocalVariableDefine> <r:@R> => {
        Statement::Variable(Location::Source(file_no, l, r), v, None)
    },
    <l:@L> <e:Expression> <r:@R> => {
        Statement::Expression(Location::Source(file_no, l, r), e)
    }
}

NonIfStatement: Statement = {
    BlockStatement => <>,
    <l:@L> "assembly" <dialect:StringLiteral?> <block:BlockStatement> <r:@R> => {
        Statement::Assembly {
            loc: Location::Source(file_no, l, r),
            dialect: dialect.map(|dialect| dialect.to_owned()),
            flags: None,
            block: Box::new(block)
        }
    },
    <l:@L> "formula" <dialect:StringLiteral?> <block:FormulaBlock> <r:@R> => {
        Statement::Formula {
            loc: Location::Source(file_no, l, r),
            dialect: dialect.map(|dialect| dialect.to_owned()),
            flags: None,
            block: Box::new(block)
        }
    },
    <f:InlineFormulaDefine> => {
        Statement::InlineFormula(f)
    },
    <SimpleStatement> ";" => <>,
    <l:@L> "continue" <r:@R> ";" => {
        Statement::Continue(Location::Source(file_no, l, r))
    },
    <l:@L> "break" <r:@R> ";" => {
        Statement::Break(Location::Source(file_no, l, r))
    },
    <l:@L> "return" <r:@R> ";" => {
        Statement::Return(Location::Source(file_no, l, r), None)
    },
    <l:@L> "return" <e:Expression> <r:@R> ";" => {
        Statement::Return(Location::Source(file_no, l, r), Some(e))
    },
}


StringLiteral: StringLiteral = {
    <l:@L> <s:string> <r:@R> => {
        StringLiteral{ loc: Location::Source(file_no, l, r), unicode: s.0, string: s.1.to_string() }
    }
}

FormulaIdentifier: Identifier = {
    <l:@L> <n:identifier> <r:@R> => Identifier{loc: Location::Source(file_no, l, r), name: n.to_string()},
    <l:@L> "extern" <r:@R> => Identifier{loc: Location::Source(file_no, l, r), name: "extern".to_string()},
    <l:@L> "import" <r:@R> => Identifier{loc: Location::Source(file_no, l, r), name: "import".to_string()},
    <l:@L> "as" <r:@R> => Identifier{loc: Location::Source(file_no, l, r), name: "as".to_string()},
}

FormulaStatement: FormulaStatement = {
    <FormulaBlock> => FormulaStatement::Block(<>),
    <FormulaFunction> => FormulaStatement::Function(Box::new(<>)),
    <l:@L><false_token:!><r:@R> => {
        parser_errors.push(false_token);
        FormulaStatement::Error(Location::Source(file_no, l ,r))
    },
}

FormulaBlock: FormulaBlock = {
    <l:@L> "{" <statements:FormulaStatement*> "}" <r:@R> => FormulaBlock{loc: Location::Source(file_no, l, r), statements},
}

FormulaLiteral: FormulaExpression = {
    <a:@L> "true" <t_type:(":" <FormulaIdentifier>)?> <b:@R> => FormulaExpression::Bool(Location::Source(file_no, a, b), true, t_type),
    <a:@L> "false" <t_type:(":" <FormulaIdentifier>)?> <b:@R> => FormulaExpression::Bool(Location::Source(file_no, a, b), false, t_type),
    <l:@L> <n:number> <t_type:(":" <FormulaIdentifier>)?> <r:@R> => {
        FormulaExpression::Number(Location::Source(file_no, l, r), n, t_type)
    },
    <str:StringLiteral> <t_type:(":" <FormulaIdentifier>)?> => {
        FormulaExpression::String(str, t_type)
    },
}

FormulaFunction: FormulaFunction = {
    <l:@L> <id:FormulaIdentifier> "(" <arguments:Comma<FormulaExpression>> ")" <r:@R> => {
        FormulaFunction{loc: Location::Source(file_no, l, r), id, arguments}
    }
}

FormulaPath: FormulaExpression = {
    <FormulaIdentifier> => FormulaExpression::Variable(<>),
    <l:@L> <array:FormulaPath> "." <member:FormulaIdentifier> <r:@R> => {
        FormulaExpression::SuffixAccess(Location::Source(file_no, l, r), Box::new(array), member)
    },
}

FormulaExpression: FormulaExpression = {
    <FormulaPath> => <>,
    <FormulaFunction> => FormulaExpression::Function(Box::new(<>)),
    <FormulaLiteral> => <>,
}

Comma<T>: Vec<T> = {
    => Vec::new(),
    CommaOne<T> => <>,
};

CommaOne<T>: Vec<T> = {
    <e:T> <v:("," <T>)*> => {
        let mut v = v;
        v.insert(0, e);
        v
    }
};

CommaTwo<T>: Vec<T> = {
    <e:T> <v:("," <T>)+> => {
        let mut v = v;
        v.insert(0, e);
        v
    }
};

extern {
    type Location = usize;
    type Error = LexicalError;

    enum Token<'input> {
        identifier => Token::Identifier(<&'input str>),
        string => Token::StringLiteral(<bool>, <&'input str>),
        number => Token::Number(<i64>),
        address => Token::AddressLiteral(<&'input str>),
        rational => Token::RationalNumber(<&'input str>, <bool>),
        "#" => Token::Sharp,
        ";" => Token::Semicolon,
        ":" => Token::Colon,
        "{" => Token::OpenCurlyBrace,
        "}" => Token::CloseCurlyBrace,
        "(" => Token::OpenParenthesis,
        ")" => Token::CloseParenthesis,
        "=" => Token::Assign,
        ":=" => Token::ColonAssign,
        "==" => Token::Equal,
        "||" => Token::Or,
        "&&" => Token::And,
        "!=" => Token::NotEqual,
        "<" => Token::Less,
        "<=" => Token::LessEqual,
        ">" => Token::More,
        ">=" => Token::MoreEqual,
        "|" => Token::BitwiseOr,
        "^" => Token::BitwiseXor,
        "&" => Token::BitwiseAnd,
        "<<" => Token::ShiftLeft,
        ">>" => Token::ShiftRight,
        "+" => Token::Add,
        "-" => Token::Subtract,
        "*" => Token::Mul,
        "/" => Token::Divide,
        "%" => Token::Modulo,
        "**" => Token::Power,
        "!" => Token::Not,
        "~" => Token::BitwiseNot,
        "[" => Token::OpenBracket,
        "]" => Token::CloseBracket,
        "." => Token::Member,
        "?" => Token::Question,
        "," => Token::Comma,
        "import" => Token::Import,
        "type" => Token::Type,
        "cond" => Token::Condition,
        "const" => Token::Constant,
        "in"    => Token::PortIn,
        "out"   => Token::PortOut,
        "inout" => Token::PortInOut,
        "address" => Token::Address,
        "extern" => Token::Extern,
        "true" => Token::True,
        "false" => Token::False,
        "fn" => Token::Function,
        "return" => Token::Return,
        "if" => Token::If,
        "match" => Token::Match,
        "_" => Token::Wildcard,
        "=>" => Token::FatArrow,
        "for" => Token::For,
        "loop" => Token::Loop,
        "while" => Token::While,
        "else" => Token::Else,
        "continue" => Token::Continue,
        "break" => Token::Break,
        "as" => Token::As,
        "assembly" => Token::Assembly,
        "formula" => Token::Formula,
        "->" => Token::Arrow,
        "-->" => Token::PeirceArrow,
        "model" => Token::Model,
        "state" => Token::State,
        "start" => Token::Start,
        "ref" => Token::Reference,
        "next" => Token::Next,
        "var" => Token::Variable,
        "enum" => Token::Enum,
        "struct" => Token::Struct,
        "from" => Token::From,
        "X" => Token::LtlNext,
        "F" => Token::LtlFinally,
        "G" => Token::LtlGlobally,
        "U" => Token::LtlUntil,
        "R" => Token::LtlRelease,
        "LTL" => Token::TypeLtl,
        "Guard" => Token::TypeGuard,
    }
}
