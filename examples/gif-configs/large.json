{
    "_comment": "Крупный кадр 1280x960 для больших моделей. Дольше задержка между кадрами.",

    "canvas": {
        "width": 1280.0,
        "height": 960.0,
        "frame_delay_cs": 80,
        "highlight_frame_delay_cs": 250
    },

    "node": {
        "radius": 35.0,
        "min_distance": 40.0,
        "stroke_width": 3,
        "stroke_width_active": 5,
        "text_font_size": 18.0
    },

    "edge": {
        "arrow_size": 6.0,
        "curve_coefficient": 0.08,
        "stroke_width": 2.5,
        "highlight_stroke_width": 5.0
    },

    "edge_label": {
        "font_size": 14.0,
        "char_width": 11.0,
        "margin": 4.0,
        "search_radii": [0.0, 20.0, 40.0, 65.0, 95.0, 130.0, 170.0, 220.0],
        "search_angles": 24
    },

    "legend": {
        "width": 260.0,
        "padding": 8.0,
        "line_height": 20.0,
        "font_size": 13.0,
        "swatch_radius": 6.0,
        "bg_radius": 6.0
    },

    "highlight": {
        "border_width": 8.0,
        "header_height": 40.0,
        "header_font_size": 18.0
    },

    "model_name": {
        "font_size": 18.0,
        "y_offset": 22.0
    },

    "layout": {
        "iterations_per_temperature_factor": 150
