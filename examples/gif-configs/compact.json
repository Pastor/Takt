{
    "_comment": "Компактный кадр 640x480 с уменьшенными узлами и шрифтами — для маленьких автоматов.",

    "canvas": {
        "width": 640.0,
        "height": 480.0,
        "frame_delay_cs": 40,
        "highlight_frame_delay_cs": 120
