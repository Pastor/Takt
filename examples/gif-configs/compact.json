    },

    "legend": {
        "width": 150.0,
        "padding": 4.0,
        "line_height": 12.0,
        "font_size": 9.0,
        "swatch_radius": 3.0
    },

    "highlight": {
        "border_width": 4.0,
        "header_height": 22.0,
