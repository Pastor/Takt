// ПРИМЕНЕНИЕ библиотечного регулятора: подогрев теплоносителя.
//
// Регулятор берётся готовым — из `pid_law.takt`, вместе с протоколом связи
// (`target`, `meas`, `ctrl`). Здесь описан только **объект управления**:
// нагреватель, к которому подведена мощность `ctrl` и который отдаёт тепло в
// среду. Контур замыкается композицией: регулятор считает воздействие по
// измерению, объект пересчитывает измерение по воздействию.
//
// Так и выглядит переиспользование: тот же `Pid` можно приложить к другому
// объекту, ничего в нём не меняя, — достаточно описать свою модель объекта.
//
// ОБЪЕКТ. Тепловой объект первого порядка: за такт температура растёт от
// подведённой мощности и падает от потерь, пропорциональных перегреву над
// средой:
//     meas[k+1] = meas[k] + gain·ctrl[k] − loss·(meas[k] − ambient)
//
// ЦИКЛ ПАРТИИ. Бак периодического действия: партию греют до уставки, затем
// выдерживают, пока она не остынет до температуры выдачи, — и цикл окончен.
// Поэтому прогон без входных данных сходится сам и ЗАВЕРШАЕТСЯ: Heating →
// Holding → Done у объекта, Control → Settled → Done у регулятора.
//
// ДВЕ СТУПЕНИ, ДВЕ НАСТРОЙКИ. Ступени идут последовательной композицией: сперва
// штатный нагрев до 40°, затем дожиг до 55° — и у второй ступени СВОЯ настройка
// регулятора (мягче пропорциональный канал, сильнее интегральный). Обе ступени —
// экземпляры ОДНИХ И ТЕХ ЖЕ моделей: отличаются только значениями параметров,
// заданными в месте инстанцирования.
//
// ⚠️ Два контура в одном файле именно ПОСЛЕДОВАТЕЛЬНЫ, а не параллельны:
// протокол связи (`target`/`meas`/`ctrl`) объявлен библиотекой в единственном
// числе, и два одновременных контура делили бы одни и те же величины. Ступени
// же разделены во времени — каждая работает со своим набором значений
// параметров, передавая следующей достигнутое состояние объекта.
import {Pid, target, meas, ctrl} from "pid_law.takt";

// Свойства установки: усиление нагрева, доля потерь и температура среды. Это не
// настройка ступени, а физика бака — она одна на обе ступени.
var gain: float := 0.5;
var loss: float := 0.05;
var ambient: float := 18.0;

model Heater {
    out temperature: float := 0.0; // то, что видит оператор на панели

    // Настройка ступени: до чего греем и при какой температуре отдаём партию.
    parameter setpoint: float := 40.0;
    parameter release: float := 38.0;

    start Heating {
        // Уставку контура задаёт объект: это ОН знает, чего добивается ступень.
        enter {
            target := setpoint;
        }
        always {
            meas := meas + gain * ctrl - loss * (meas - ambient);
            temperature := meas;
        }
        // Регулятор снял воздействие — значит уставка достигнута.
        ref Holding: ctrl <= 0.0;
    }

    // Выдержка: мощность снята, партия остывает по тем же потерям.
    state Holding {
        always {
            meas := meas - loss * (meas - ambient);
            temperature := meas;
        }
        ref Done: meas <= release;
    }

    state Done;
}

// Ступень 1 — штатная настройка регулятора и уставка 40°; ступень 2 — дожиг до
// 55° мягче: пропорциональный канал вдвое слабее, интегральный вдвое сильнее.
start PidHeater = (Pid | Heater) + (Pid(kp := 0.25, ki := 0.125) | Heater(setpoint := 55.0, release := 52.0)) {
    next Finished;
}

state Finished;
