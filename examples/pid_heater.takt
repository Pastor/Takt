// ПРИМЕНЕНИЕ библиотечного регулятора: подогрев теплоносителя.
//
// Регулятор берётся готовым — из `pid_law.takt`. Библиотека даёт применению
// ДВЕ вещи: тип состояния контура (`struct PidState`) и протокол связи с объектом
// (`target`, `meas`, `ctrl`):
//
//     import { PidState, target, meas, ctrl } from "pid_law.takt";
//
// Здесь описан только **объект управления**: бак, к которому подведена мощность
// `ctrl` и который отдаёт тепло в среду. Контур замыкается в такте: по
// измерению считается воздействие, по воздействию пересчитывается измерение.
//
// ⚠️ Шаг закона написан ЗДЕСЬ, а не взят из библиотеки функцией. Причина — не
// стиль, а граница языка: `import` переносит типы, переменные и модели, но
// **не функции** (`SE-017`). Библиотека поэтому отдаёт применению устройство
// состояния и протокол, а не саму операцию; в `pid_law.takt` та же арифметика
// записана функцией `pid_compute` и работает над тем же типом.
//
// ОБЪЕКТ. Тепловой объект первого порядка: за такт температура растёт от
// подведённой мощности и падает от потерь, пропорциональных перегреву над
// средой:
//     meas[k+1] = meas[k] + gain·ctrl[k] − loss·(meas[k] − ambient)
//
// ЦИКЛ ПАРТИИ. Бак периодического действия: партию греют до уставки, затем
// выдерживают, пока она не остынет до температуры выдачи, — и цикл окончен.
// Поэтому прогон без входных данных сходится сам и ЗАВЕРШАЕТСЯ.
//
// ДВЕ СТУПЕНИ, ДВЕ НАСТРОЙКИ. Ступени идут последовательной композицией: сперва
// штатный нагрев до 40°, затем дожиг до 55° — и у второй ступени СВОЯ настройка
// регулятора: мягче пропорциональный канал, сильнее интегральный.
//
// ⚠️ Настройка задаётся ЗНАЧЕНИЯМИ ПОЛЕЙ структуры, а не параметрами модели. В
// этом и разница между регулятором-типом и регулятором-автоматом: контуров
// столько, сколько объявлено переменных, и каждый несёт свою настройку — а не
// столько, сколько инстанцировано моделей.
import {PidState, target, meas, ctrl} from "pid_law.takt";

// Свойства установки: усиление нагрева, доля потерь и температура среды. Это не
// настройка ступени, а физика бака — она одна на обе ступени.
var gain: float := 0.5;
var loss: float := 0.05;
var ambient: float := 18.0;

model Heater {
    out temperature: float := 0.0; // то, что видит оператор на панели

    // Состояние контура этой ступени — экземпляр типа из библиотеки.
    // Поля: kp, ki, kd, ts, out_min, out_max, i_acc, err_prev, output.
    var loop_pid: PidState := {0.5, 0.0625, 0.25, 1.0, 0.0, 32.0, 0.0, 0.0, 0.0};

    // Настройка ступени: до чего греем и при какой температуре отдаём партию.
    parameter setpoint: float := 40.0;
    parameter release: float := 38.0;

    // Рабочие величины шага закона.
    var err: float := 0.0;
    var i_new: float := 0.0;
    var raw: float := 0.0;

    start Heating {
        // Уставку контура задаёт объект: это ОН знает, чего добивается ступень.
        enter {
            target := setpoint;
        }
        always {
            // ─── Шаг закона над состоянием контура ────────────────────────────
            err := target - meas;
            i_new := loop_pid.i_acc + loop_pid.ki * err * loop_pid.ts;
            raw := loop_pid.kp * err + i_new + loop_pid.kd * (err - loop_pid.err_prev) / loop_pid.ts;
            if raw > loop_pid.out_max {
                ctrl := loop_pid.out_max;
                if err <= 0.0 {
                    // Ошибка толкает выход дальше за предел — накопитель замораживаем.
                    loop_pid.i_acc := i_new;
                }
            } else if raw < loop_pid.out_min {
                ctrl := loop_pid.out_min;
                if err >= 0.0 {
                    loop_pid.i_acc := i_new;
                }
            } else {
                ctrl := raw;
                loop_pid.i_acc := i_new;
            }
            loop_pid.err_prev := err;
            loop_pid.output := ctrl;

            // ─── Объект: подведённая мощность и потери в среду ────────────────
            meas := meas + gain * ctrl - loss * (meas - ambient);
            temperature := meas;
        }
        // Уставка достигнута — воздействие снято, ступень переходит к выдержке.
        ref Holding: err <= 0.0;
    }

    // Выдержка: мощность снята, партия остывает по тем же потерям.
    state Holding {
        enter {
            ctrl := 0.0;
        }
        always {
            meas := meas - loss * (meas - ambient);
            temperature := meas;
        }
        ref Done: meas <= release;
    }

    state Done;
}

// Ступень 1 — штатная настройка и уставка 40°; ступень 2 — дожиг до 55°.
start PidHeater = Heater + Heater(setpoint := 55.0, release := 52.0) {
    next Finished;
}

state Finished;
