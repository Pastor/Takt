@startuml
title ElevatorMini

[*] --> Main
Main : Cabin | Motor
Main --> [*]

state Cabin {
    [*] --> Idle
    Moving --> AtFloor
    AtFloor --> Idle
    Idle --> Moving
}

state Motor {
    [*] --> Idle
    Idle --> Up
    Idle --> Down
    Idle --> Stop
    Up --> Stop
    Down --> Stop
    Stop --> Idle
}

@enduml
