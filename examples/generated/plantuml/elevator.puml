@startuml
title Elevator

[*] --> Main
Middle : Engine + Engine | Engine + Engine + Engine + Engine
Middle --> End
Main : Engine
Main --> Middle
End --> [*]

state Engine {
    [*] --> Idle
    DoorOpening --> Idle
    Idle --> DoorClosing
    MovingDown --> DoorOpening
    DoorClosing --> Idle
    DoorClosing --> MovingUp
    DoorClosing --> MovingDown
    MovingUp --> DoorOpening
}

@enduml
