@startuml
title Stacker

[*] --> Stacker
Stacker : CommandReceiver | MovementController | LiftController
Stacker --> [*]

state LiftController {
    [*] --> LiftIdle
    LiftOperating --> LiftDone
    LiftOperating --> LiftDone
    LiftOperating --> LiftIdle
    LiftDone --> LiftIdle
    LiftIdle --> LiftOperating
}

state CommandReceiver {
    [*] --> WaitingForTask
    AcceptingTask --> TaskActive
    TaskActive --> WaitingForTask
    WaitingForTask --> AcceptingTask
}

state MovementController {
    [*] --> MovementIdle
    WaitingForkAtPickup --> MovingToCell
    MovingToCell --> WaitingForkAtCell
    MovingToCell --> EmergencyCharge
    MovingToDropoff --> WaitingForkAtDropoff
    MovingToDropoff --> EmergencyCharge
    MovingToPickup --> WaitingForkAtPickup
    MovingToPickup --> EmergencyCharge
    TaskCompleting --> MovementIdle
    WaitingForkAtDropoff --> TaskCompleting
    WaitingForkAtStorage --> MovingToDropoff
    MovementIdle --> DispatchMove
    WaitingForkAtCell --> TaskCompleting
    DispatchMove --> MovingToPickup
    DispatchMove --> MovingToStorage
    MovingToStorage --> WaitingForkAtStorage
    MovingToStorage --> EmergencyCharge
    EmergencyCharge --> MovementIdle
}

@enduml
