@startuml
title PidHeater

[*] --> PidHeater
Finished --> [*]
PidHeater : Pid | Heater + Pid | Heater
PidHeater --> Finished

state Heater {
    [*] --> Heating
    Done --> [*]
    Heating --> Holding
    Holding --> Done
}

state Pid {
    [*] --> Control
    Control --> Settled
    Done --> [*]
    Settled --> Done
}

@enduml
