@startuml
title ExtendComplex

[*] --> Start
Start : A + B + C | D + E
Start --> Next
Next : F
Next --> [*]

state C {
    [*] --> Start
    End --> [*]
    Start : C1 | C2
    Start --> End
}

state A {
    [*] --> Start
    Start --> [*]
}

state D {
    [*] --> Start
    Start --> [*]
}

state C1 {
    [*] --> Start
    Start --> End
    End --> [*]
}

state E {
    [*] --> Start
    Start : D + F
    Start --> End
    End --> [*]
}

state B {
    [*] --> Start
    Start --> [*]
}

state F {
    [*] --> Start
    Start --> [*]
}

state C2 {
    [*] --> Start
    Start --> [*]
}

@enduml
