// ПИД-регулятор как ПЕРЕИСПОЛЬЗУЕМАЯ модель — библиотека контура управления.
//
// Файл описывает только закон управления и **протокол связи** с объектом:
// уставку `target`, измерение `meas` и управляющее воздействие `ctrl`. Модели
// объекта здесь нет — её приносит применение (`pid_heater.takt`), подключая
// регулятор вместе с этими тремя переменными:
//
//     import { Pid, target, meas, ctrl } from "pid_law.takt";
//
// Так один и тот же регулятор прикладывается к разным объектам, а объект не
// знает об устройстве регулятора. Соседний `pid_regulator.takt` решает другую
// задачу — показывает представление чисел (`float` → q флагами сборки), — и
// объект управления в нём вшит намеренно.
//
// ⚠️ Протокол связи объявляет ОДНА сторона. Если бы объект жил в своём файле и
// объявлял `ctrl`/`meas` у себя, применение получило бы ДВЕ пары переменных:
// подключение двух файлов строит два независимых дерева, и общей переменной
// между ними не возникает.
//
// ТЕОРИЯ. Позиционная дискретная форма ПИД по рассогласованию err = target − meas
// (такт = шаг, Ts = 1):
//     err[k]   = target − meas[k]
//     i_acc[k] = i_acc[k−1] + err[k]      (интеграл — сумма ошибок)
//     deriv[k] = err[k] − err_prev[k]     (производная — разность назад)
//     ctrl[k]  = Kp·err[k] + Ki·i_acc[k] + Kd·deriv[k]
//
// ANTI-WINDUP. Интеграл ограничен [−Imax, Imax] условиями: насыщающего оператора
// в языке нет. В q-представлении (встраиваемые цели, FPGA) арифметика — перенос,
// и без ограничения накопитель «перевернулся» бы, сделав контур неустойчивым.
//
// ⚠️ Имена не конфликтуют со стандартной библиотекой IEC 61131-3 (идентификаторы
// там регистронезависимы): `integral` и `pv` заняты, поэтому `i_acc` и `meas`.
//
// ⚠️ Файл назван `pid_law.takt`, а не `pid.takt`, намеренно: имя корневой модели
// берётся из имени файла, и `pid.takt` дал бы корень `Pid` при под-модели `Pid`
// — цель `rust` такой вход отвергает (`RS-012`), хотя `c` и `st` принимают.

// ─── Протокол связи с объектом ───────────────────────────────────────────────
var target: float := 40.0; // уставка SP — чего добиваемся
var meas: float := 0.0; // измерение PV — что сообщает датчик объекта
var ctrl: float := 0.0; // управляющее воздействие MV — что подаём на привод

model Pid {
    // Бит 0 регистра статуса 0x600: поднят, когда контур сошёлся. Инициализатор
    // порта задаёт АДРЕС, а не начальное значение.
    out ready: bit at 0x600:0;

    // ⚠️ Порт назван `ready`, а не `settled`: выходной порт и состояние с
    // ОДИНАКОВЫМ именем дают в цели `c` один и тот же перечислитель, и
    // порождённый код перестаёт компилироваться (`redefinition of enumerator`)
    // — при том что компилятор рапортует об успехе.

    // ─── Настройка регулятора ────────────────────────────────────────────────
    // Объявлена ПАРАМЕТРАМИ: значения ниже — умолчания для типовой установки, а
    // применение задаёт свои в месте инстанцирования (`Pid(kp := 0.25)`), не
    // правя библиотеку. Наружу по-прежнему торчит только контур
    // (`target`/`meas`/`ctrl`) — подключают три имени, а не полтора десятка.
    //
    // ⚠️ Параметром выражают НАСТРОЙКУ СБОРКИ. Уставка `target` параметром не
    // становится: её меняют в работе, и она остаётся переменной протокола.
    parameter kp: float := 0.5; // пропорциональный коэффициент
    parameter ki: float := 0.0625; // интегральный
    parameter kd: float := 0.25; // дифференциальный

    parameter imax: float := 32.0; // предел накопителя (anti-windup)
    parameter eps: float := 0.5; // порог «сошлись» (больше шага квантования)

    // Нижний предел накопителя — зеркало верхнего. Считается при входе в такт
    // управления, а не объявляется вторым параметром: иначе задавший `imax`
    // получил бы несимметричное ограничение и не заметил этого.
    var neg_imax: float := -32.0;

    // ─── Рабочие величины такта ──────────────────────────────────────────────
    var err: float := 0.0;
    var err_prev: float := 0.0;
    var i_acc: float := 0.0;
    var deriv: float := 0.0;

    start Control {
        enter {
            neg_imax := 0.0 - imax;
        }
        always {
            err := target - meas;
            i_acc := i_acc + err;
            if i_acc > imax {
                i_acc := imax;
            }
            if i_acc < neg_imax {
                i_acc := neg_imax;
            }
            deriv := err - err_prev;
            ctrl := kp * err + ki * i_acc + kd * deriv;
            err_prev := err;
        }
        ref Settled: err < eps;
    }

    // Сошлись: воздействие снимаем, объект дальше держит достигнутое.
    state Settled {
        enter {
            ctrl := 0.0;
            ready := 1;
        }
        ref Done;
    }

    state Done;
}

// Регулятор без объекта: измерение никто не меняет, поэтому сам по себе файл
// показывает только разгон воздействия. Осмысленный прогон — у применения.
start Main = Pid;
