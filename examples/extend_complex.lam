type u8 = [bit; 8];

var x: u8 = 1;
var y: u8 = 2;
const ENABLED: bool = true;
struct Coord {
  x: [bit; 32],
  y: [bit; 32],
  z: [bit; 32]
}
const c: Coord = {0, 0, 0};
enum Constant {
    X, Y, Z
}
out IDLE: bit = 0x44533932:1;
out WORK: bit = 0x44533932:2;
in  WAIT: bit = 0x44533932:33;

fn is_collected(c: Constant, v: u8) -> bool {
    if c == X && v == 1 {
        return true;
    } else if c == Y && v == 2 {
        return true;
    } else if x.2 == 0 {
        return true;
    }
    return false;
}

extern fn has_flag(v: bool) -> bool;

model A {
  start Start;
}
model B {
  start Start {
    always {
        if WAIT {
            WORK = 0;
            IDLE = 1;
        } else {
            IDLE = 0;
            WORK = 1;
        }
    }
  }
}
model C {
  enum Point {
    Global,
    Local
  }
  model C1 {
    start Start {
        ref End: is_collected(Y, y) & is_collected(X, x) & has_flag(ENABLED);
    }
    state End;
  }
  model C2 {
    start Start;
  }
  start Start = C1 | C2 {
    next End;
  }
  state End;
}
model D {
  start Start;
}
model E {
  start Start = D + F {
    next End;
  }
  state End;
}
model F {
  start Start;
}
start Start = A + B + (C | D) + E {
    next Next;
    : E != End;
    : x > 0;
}
state Next = F;
