// ПИД-регулятор (Пропорционально-Интегрально-Дифференциальный) на fixed-point
// q(8, 8) — пример фичи 0097. Самый распространённый закон управления.
//
// ТЕОРИЯ. Непрерывный ПИД по рассогласованию err = target − meas:
//     ctrl = Kp·err + Ki·∫err dt + Kd·derr/dt
// Позиционная дискретная форма (такт = шаг, Ts = 1):
//     err[k]  = target − meas[k]
//     i_acc[k] = i_acc[k−1] + err[k]        (интеграл — сумма ошибок)
//     deriv[k] = err[k] − err_prev[k]       (производная — разность назад)
//     ctrl[k]  = Kp·err[k] + Ki·i_acc[k] + Kd·deriv[k]
// Замкнутый контур: объект 1-го порядка meas[k+1] = meas[k] + Kplant·ctrl[k] —
// контур самодостаточен (без внешних входов), проходит гейт достижимости 0030.
//
// ANTI-WINDUP. Арифметика q(m, n) — ПЕРЕНОС (wraparound), не насыщение; без
// ограничения интеграл i_acc переполнил бы q и «перевернулся» (+127 → −128) —
// регулятор стал бы неустойчивым. Поэтому i_acc ограничен [−Imax, Imax]
// условиями (насыщающего оператора в языке нет — кандидат на будущее).
//
// ⚠️ Имена НЕ конфликтуют со стандартными ФБ IEC 61131-3 (идентификаторы IEC
// регистронезависимы): `integral`/`pv` заняты (FB INTEGRAL, вход PV), поэтому
// `i_acc`/`meas`.
//
// Обёрнут под-моделью (цель `c`: typedef корня); порт `ready` (цель `rust`:
// clippy::new_without_default). SV-транслируем (нет extern fn/циклов/float).
model Pid {
    out ready: bit := 0;

    // Контур управления.
    var target: q(8, 8) := 8.0; // уставка SP
    var meas: q(8, 8) := 0.0; // измерение PV (выход объекта)
    var i_acc: q(8, 8) := 0.0; // накопитель интеграла
    var err_prev: q(8, 8) := 0.0; // ошибка на прошлом такте (для производной)

    // Коэффициенты ПИД и объекта (дробные — суть fixed-point).
    var kp: q(8, 8) := 0.5; // пропорциональный
    var ki: q(8, 8) := 0.0625; // интегральный
    var kd: q(8, 8) := 0.25; // дифференциальный
    var kplant: q(8, 8) := 0.5; // усиление объекта

    // Пределы anti-windup и порог завершения.
    var imax: q(8, 8) := 32.0;
    var neg_imax: q(8, 8) := -32.0;
    var eps: q(8, 8) := 0.125;

    // Рабочие величины такта.
    var err: q(8, 8) := 0.0;
    var deriv: q(8, 8) := 0.0;
    var ctrl: q(8, 8) := 0.0;

    start Control {
        always {
            err := target - meas;
            i_acc := i_acc + err;
            if i_acc > imax {
                i_acc := imax;
            }
            if i_acc < neg_imax {
                i_acc := neg_imax;
            }
            deriv := err - err_prev;
            ctrl := kp * err + ki * i_acc + kd * deriv;
            meas := meas + kplant * ctrl;
            err_prev := err;
        }
        // Сошлись: err мало (порог > шага квантования, иначе предельный цикл).
        ref Settled: err < eps;
    }
    // Доводим точно до уставки.
    state Settled {
        always {
            meas := target;
        }
        ref Done;
    }
    // Установившееся состояние: флаг готовности.
    state Done {
        always {
            ready := 1;
        }
    }
}

start Main = Pid;
