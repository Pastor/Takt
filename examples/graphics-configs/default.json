{
    "_comment": "Конфигурация по умолчанию: цвета и размеры, идентичные зашитым в код.",

    "output_mode": "gif",

    "canvas": {
        "width": 800.0,
        "height": 600.0,
        "frame_delay_cs": 50,
        "highlight_frame_delay_cs": 150
    },

    "node": {
        "radius": 25.0,
        "min_distance": 25.0,
        "active_fill": "#FFE066",
        "inactive_fill": "#cce5ff",
        "stroke": "#333",
        "stroke_width": 2,
        "stroke_width_active": 3,
        "text_font_family": "\"GOST 2.304-81 Type A\", \"GOST type A\", \"OpenGOST Type A\", sans-serif",
        "text_font_size": 14.0,
        "text_color": "black"
    },

    "edge": {
        "arrow_size": 4.0,
        "curve_coefficient": 0.10,
        "stroke": "#444",
        "stroke_width": 2.0,
        "highlight_stroke": "#FF8C00",
        "highlight_stroke_width": 3.5
    },

    "edge_label": {
        "font_family": "\"GOST 2.304-81 Type A\", \"GOST type A\", \"OpenGOST Type A\", sans-serif",
        "font_size": 11.0,
        "char_width": 9.0,
        "margin": 3.0,
        "text_color": "#222",
        "bg_fill": "#FFF3CD",
        "bg_stroke": "#FF8C00",
        "bg_stroke_width": 1.5,
        "bg_radius": 2.0,
        "search_radii": [0.0, 15.0, 30.0, 50.0, 70.0, 90.0, 115.0, 145.0, 180.0],
        "search_angles": 16,
        "leader_color": "#FF8C00",
        "leader_width": 1.0,
        "leader_dasharray": "3,2"
    },

    "legend": {
        "width": 190.0,
        "padding": 5.0,
        "line_height": 15.0,
        "bg_fill": "#f8f8f8",
        "bg_stroke": "#bbb",
        "bg_stroke_width": 1.0,
        "bg_radius": 4.0,
        "font_family": "monospace",
        "font_size": 10.0,
        "header_color": "#555",
        "value_color": "#333",
        "swatch_radius": 4.0,
        "swatch_stroke": "#555",
        "swatch_stroke_width": 1.0,
        "active_label": "активное",
        "inactive_label": "неактивное",
        "state_header": "СОСТОЯНИЯ:",
        "colors_header": "ЦВЕТА:",
        "in_header": "IN:",
        "out_header": "OUT:",
        "inout_header": "INOUT:",
        "vars_header": "VARS:"
    },

    "highlight": {
        "border_color": "#FF8C00",
        "border_width": 6.0,
        "border_inset": 1.0,
        "header_height": 30.0,
        "header_bg_color": "#FF8C00",
        "header_text_color": "white",
        "header_font_family": "monospace",
        "header_font_size": 14.0,
        "header_font_weight": "bold"
    },

    "model_name": {
        "font_family": "monospace",
        "font_size": 14.0,
        "font_weight": "bold",
        "color": "#333",
        "y_offset": 16.0
    },

    "layout": {
        "temperature_start": 500.0,
        "temperature_end": 0.1,
        "cooling_alpha": 0.995,
        "iterations_per_temperature_factor": 100,
        "weight_overlap": 1000000.0,
        "weight_length": 1.0,
        "weight_cross": 1.0,
        "cross_penalty": 500.0
    }
}
