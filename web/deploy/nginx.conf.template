# Шаблон nginx для стенда Takt (фича 0531, задача 07c).
#
# Подстановки: __SERVER_NAME__, __UPSTREAM__ (адрес сервера, например
# 127.0.0.1:8730), __BODY_LIMIT__ (предел тела, например 2m).
#
# ⚠️ Правило кеша ЗДЕСЬ и в сервере одно и то же — **форма адреса задаёт срок**.
# Дублирование намеренное: сервис умеет работать и без прокси (своя машина,
# проба стенда), и заголовки обязаны быть теми же, иначе проверенное локально
# ведёт себя на стенде иначе.

server {
    listen 80;
    server_name __SERVER_NAME__;

    # Версия nginx — сведения о том, что ставить нападающему.
    server_tokens off;

    # Предел тела: он же у сервера (`TAKT_WEB_BODY_LIMIT`). Разъедься они —
    # прокси отказал бы раньше, чем сервис назвал бы причину числом.
    client_max_body_size __BODY_LIMIT__;

    # Предсжатое отдаётся как есть: сервис ничего не сжимает на лету (модуль
    # 3,3 МБ, и сжимать его каждому заходу — лишняя работа).
    gzip_static on;

    # Помеченное отпечатком неизменно: год и `immutable`.
    location ~ ^/(b|wasm)/[^/]+/ {
        proxy_pass http://__UPSTREAM__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Описи читают ради свежести — вечными им быть нельзя.
    location ~ ^/(index\.html|version\.json|wasm/index\.json)?$ {
        proxy_pass http://__UPSTREAM__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        add_header Cache-Control "no-cache" always;
    }

    location / {
        proxy_pass http://__UPSTREAM__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        add_header Cache-Control "no-cache" always;
    }

    # Сервис лежит — заставка, а не голая ошибка прокси.
    error_page 502 503 504 /503.html;
    location = /503.html {
        internal;
        return 503 "Takt: сервис недоступен, попробуйте позже\n";
        default_type text/plain;
    }
}
