# Окружение стенда Takt (фича 0531, задача 07d).
#
# Скопируйте в `web/deploy/.env` и заполните. ⚠️ Сам `.env` в дерево не
# коммитится: в нём пароль базы и секрет подписи токенов.

# Локейшен, под которым сервис отдаёт nginx. Тот же префикс задаётся скрипту
# настройки nginx (`PREFIX=/takt`) — иначе страница будет строить адреса от
# одного корня, а прокси отдавать от другого.
TAKT_WEB_BASE_PATH=/takt

# ⚠️ Секрет подписи access-токенов. Без него подъём стенда отказывает: с
# умолчанием токен подпишет кто угодно.
# Сгенерировать: openssl rand -base64 48
TAKT_WEB_JWT_SECRET=

# База. Пароль — свой, не из примера.
POSTGRES_USER=takt
POSTGRES_PASSWORD=
POSTGRES_DB=takt_web

# Куда слушать: только петля — наружу сервис выпускает nginx.
TAKT_WEB_BIND=127.0.0.1:8730

# Срок хранения проекта без обращений, дней (задача 09h).
TAKT_WEB_RETENTION_DAYS=90
