// Ступень 2: между ядром и шиной кода встал КЕШ КОМАНД.
//
// Кеш прямого отображения на четыре строки: номер строки — младшая часть адреса,
// тег — старшая. Попадание отдаёт команду сразу, промах идёт на шину кода и
// заполняет строку. Первый проход цикла — сплошные промахи, второй — попадания:
// это видно по счётчикам `hits` и `misses`.

// ─── Шина «ядро ↔ кеш» ───────────────────────────────────────────────────────
var fetch_addr: u8 := 0; // какую команду просит ядро
var fetch_req: bit := 0; // запрос выставлен
var fetch_op: u8 := 0; // ответ кеша: опкод
var fetch_arg: u8 := 0; // ответ кеша: аргумент
var fetch_ready: bit := 0; // ответ готов

// ─── Шина кода «кеш ↔ память» ────────────────────────────────────────────────
// Память команд МЕДЛЕННАЯ: ответ приходит не сразу, а через несколько тактов
// ожидания. Именно поэтому кеш и ставят.
var code_addr: u8 := 0;
var code_req: bit := 0; // запрос к памяти выставлен
var code_op: u8 := 0;
var code_arg: u8 := 0;
var code_ready: bit := 0; // память ответила

// ─── Шина данных «ядро ↔ память» ─────────────────────────────────────────────
var data_addr: u8 := 0;
var data_rdata: u8 := 0;
var data_wdata: u8 := 0;
var data_wen: bit := 0;

enum Op { Nop = 0, Lda = 1, Sta = 2, Add = 3, Sub = 4, Jnz = 5, Hlt = 6 }

model Memory {
    // Программа та же, что у ступени 1: sum := x * n.
    //     0: LDA 0   ; acc := sum        4: SUB 3   ; acc -= 1
    //     1: ADD 1   ; acc += x          5: STA 2   ; n := acc
    //     2: STA 0   ; sum := acc        6: JNZ 0   ; пока n ≠ 0 — на начало
    //     3: LDA 2   ; acc := n          7: HLT
    var prog_op: [u8; 8] := {1, 3, 2, 1, 4, 2, 5, 6};
    var prog_arg: [u8; 8] := {0, 1, 0, 2, 3, 2, 0, 0};

    var ram: [u8; 4] := {0, 7, 5, 1};

    // Сколько тактов память тратит на ответ по шине кода. Настройка сборки —
    // параметр модели: другой памяти задают другое число, не правя модель.
    parameter latency: u8 := 3;
    var wait: u8 := 3;

    start Serve {
        always {
            if code_req = 1 {
                if wait > 0 {
                    wait := wait - 1;
                    code_ready := 0;
                }
                else {
                    code_op := prog_op[code_addr];
                    code_arg := prog_arg[code_addr];
                    code_ready := 1;
                }
            }
            else {
                wait := latency;
                code_ready := 0;
            }
            if data_wen = 1 {
                ram[data_addr] := data_wdata;
            }
            data_rdata := ram[data_addr];
        }
        // Шина кода — с ожиданием: пока такты не отсчитаны, ответа нет.
        // Шина данных быстрая: ответ тем же тактом (упрощение — в жизни
        // данным тоже нужен свой кеш, это упражнение раздела).
        ref Serve;
    }
}

model Cache {
    // Строка хранит одну команду: тег, признак заполненности и саму команду.
    // Строк ровно столько, сколько команд у программы, поэтому вытеснения здесь
    // не случается: все промахи — «холодные», первого прохода. Что бывает, когда
    // программа в кеш не помещается, — упражнение раздела.
    var tags: [u8; 8] := {0, 0, 0, 0, 0, 0, 0, 0};
    var valid: [u8; 8] := {0, 0, 0, 0, 0, 0, 0, 0};
    var ops: [u8; 8] := {0, 0, 0, 0, 0, 0, 0, 0};
    var args: [u8; 8] := {0, 0, 0, 0, 0, 0, 0, 0};

    var idx: u8 := 0; // номер строки для запрошенного адреса
    var want: u8 := 0; // тег, который обязан лежать в строке
    var hits: u8 := 0; // счётчик попаданий
    var misses: u8 := 0; // счётчик промахов

    // Адрес уходит на шину кода заранее, ещё до решения «попадание или промах»:
    // при промахе ответ памяти будет здесь уже следующим тактом, а при попадании
    // он просто не нужен.
    start Lookup {
        always {
            code_addr := fetch_addr;
            idx := fetch_addr % 8;
            want := fetch_addr / 8;
            if fetch_req = 1 && valid[idx] = 1 && tags[idx] = want {
                fetch_op := ops[idx];
                fetch_arg := args[idx];
                fetch_ready := 1;
                hits := hits + 1;
            }
            else {
                fetch_ready := 0;
            }
        }
        // Адрес уходит на шину кода заранее, ещё до решения «попадание или
        // промах»: при промахе ответ памяти будет здесь уже следующим тактом,
        // а при попадании он просто не нужен.
        // ПОПАДАНИЕ обслуживается прямо здесь, тем же тактом: за этим кеш и
        // ставят. Промах уходит в отдельное состояние — он стоит такта.
        ref Miss: fetch_req = 1 & valid[idx] = 0;
        ref Miss: fetch_req = 1 & tags[idx] != want;
        ref Lookup;
    }

    // Промах: кеш выставляет запрос памяти и ЖДЁТ её ответа, а ядро ждёт кеша.
    state Miss {
        always {
            code_req := 1;
            fetch_ready := 0;
        }
        ref Fill: code_ready = 1;
        ref Miss;
    }

    // Ответ пришёл: строка заполняется и команда уходит ядру.
    state Fill {
        always {
            ops[idx] := code_op;
            args[idx] := code_arg;
            tags[idx] := want;
            valid[idx] := 1;
            fetch_op := code_op;
            fetch_arg := code_arg;
            fetch_ready := 1;
            misses := misses + 1;
            code_req := 0;
        }
        ref Lookup;
    }
}

model Core {
    var pc: u8 := 0;
    var acc: u8 := 0;
    var op: u8 := 0;
    var arg: u8 := 0;
    var next_pc: u8 := 0;

    // Выборка ждёт кеш: попадание отвечает быстрее промаха, и ядро просто
    // стоит на месте, пока ответа нет.
    start Fetch {
        always {
            data_wen := 0;
            if fetch_ready = 1 {
                fetch_req := 0;
            }
            else {
                fetch_addr := pc;
                fetch_req := 1;
            }
        }
        ref Decode: fetch_ready = 1;
        ref Fetch;
    }

    state Decode {
        always {
            op := fetch_op;
            arg := fetch_arg;
            data_addr := fetch_arg;
            next_pc := pc + 1;
        }
        ref Execute;
    }

    state Execute {
        always {
            match op {
                Lda => {
                    acc := data_rdata;
                }
                Sta => {
                    data_wdata := acc;
                    data_wen := 1;
                }
                Add => {
                    acc := acc + data_rdata;
                }
                Sub => {
                    acc := acc - data_rdata;
                }
                Jnz => {
                    if acc != 0 {
                        next_pc := arg;
                    }
                }
                _ => {}
            }
            pc := next_pc;
        }
        ref Halted: op = Hlt;
        ref Fetch;
    }

    state Halted;
}

start Machine = Core | Cache | Memory;
