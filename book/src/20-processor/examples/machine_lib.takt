// БИБЛИОТЕКА УЧЕБНОЙ МАШИНЫ: система команд, шины, память, кеш и ядро.
//
// Все ступени раздела подключают этот файл и отличаются только СБОРКОЙ —
// составом композиции и значениями параметров. Копий моделей ни у одной ступени
// нет: то, что различается, выражено параметрами, а не вторым экземпляром текста.
//
// Протокол связи объявляет ОДНА сторона — эта библиотека: подключение двух
// файлов строит два независимых дерева, и общей переменной между ними не
// возникает.

// ─── Шина «ядро ↔ кеш» ───────────────────────────────────────────────────────
var fetch_addr: u8 := 0; // какую команду просит ядро
var fetch_req: bit := 0; // запрос выставлен
var fetch_op: u8 := 0; // ответ: опкод
var fetch_arg: u8 := 0; // ответ: аргумент
var fetch_ready: bit := 0; // ответ готов

// ─── Шина «кеш ↔ память» (шина кода) ─────────────────────────────────────────
var bus_addr: u8 := 0;
var bus_req: bit := 0;
var bus_op: u8 := 0;
var bus_arg: u8 := 0;
var bus_ready: bit := 0;

// ─── Шина данных «ядро ↔ память» ─────────────────────────────────────────────
var data_addr: u8 := 0; // адрес чтения
var data_waddr: u8 := 0; // адрес записи — своя линия: читает одна стадия, пишет другая
var data_rdata: u8 := 0;
var data_wdata: u8 := 0;
var data_wen: bit := 0;

// Система команд учебной машины.
enum Op { Nop = 0, Lda = 1, Sta = 2, Add = 3, Sub = 4, Jnz = 5, Hlt = 6 }

// ─── Память: команды и данные ────────────────────────────────────────────────
model Memory {
    // Сколько тактов памяти нужно на ответ по шине кода. Настройка сборки:
    // быстрой памяти задают 0, медленной — 3, и модель при этом одна.
    parameter latency: u8 := 0;

    // Какую из двух программ исполнять: 0 — цикл, 1 — прямолинейная. Это тоже
    // настройка сборки: конвейерной ступени нужна программа без переходов.
    parameter program: u8 := 0;

    // Программа 0, «умножение сложением»: sum := x * n — складываем x n раз.
    //     0: LDA 0   ; acc := sum        4: SUB 3   ; acc -= 1
    //     1: ADD 1   ; acc += x          5: STA 2   ; n := acc
    //     2: STA 0   ; sum := acc        6: JNZ 0   ; пока n не ноль — на начало
    //     3: LDA 2   ; acc := n          7: HLT
    var loop_op: [u8; 8] := {1, 3, 2, 1, 4, 2, 5, 6};
    var loop_arg: [u8; 8] := {0, 1, 0, 2, 3, 2, 0, 0};

    // Программа 1, прямолинейная: sum := x + n + one — переходов в ней нет.
    //     0: LDA 1   ; acc := x          3: STA 0   ; sum := acc
    //     1: ADD 2   ; acc += n          4: HLT
    //     2: ADD 3   ; acc += one
    var line_op: [u8; 8] := {1, 3, 3, 2, 6, 0, 0, 0};
    var line_arg: [u8; 8] := {1, 2, 3, 0, 0, 0, 0, 0};

    // Данные: 0 — накопитель, 1 — слагаемое (7), 2 — счётчик (5), 3 — единица.
    var ram: [u8; 4] := {0, 7, 5, 1};

    var wait: u8 := 0; // сколько тактов ожидания осталось

    start Serve {
        // Шина кода — с ожиданием: пока такты не отсчитаны, ответа нет. Шина
        // данных быстрая: ответ тем же тактом (упрощение; кеш данных — упражнение).
        always {
            if bus_req = 1 {
                if wait > 0 {
                    wait := wait - 1;
                    bus_ready := 0;
                }
                else {
                    if program = 0 {
                        bus_op := loop_op[bus_addr];
                        bus_arg := loop_arg[bus_addr];
                    }
                    else {
                        bus_op := line_op[bus_addr];
                        bus_arg := line_arg[bus_addr];
                    }
                    bus_ready := 1;
                }
            }
            else {
                wait := latency;
                bus_ready := 0;
            }
            if data_wen = 1 {
                ram[data_waddr] := data_wdata;
            }
            data_rdata := ram[data_addr];
        }
        ref Serve;
    }
}

// ─── Кеш команд между ядром и шиной ──────────────────────────────────────────
model Cache {
    // Включён ли кеш. Выключенный ведёт себя как провод: каждый запрос идёт на
    // шину. Так одна модель служит и ступени «кеша нет», и ступени «кеш есть» —
    // разница в одном значении при сборке.
    parameter enabled: bit := 1;

    // Строка хранит одну команду: тег, признак заполненности и саму команду.
    // Строк столько же, сколько команд, поэтому вытеснения здесь не случается:
    // все промахи — «холодные», первого прохода. Что бывает, когда программа в
    // кеш не помещается, — упражнение раздела.
    var tags: [u8; 8] := {0, 0, 0, 0, 0, 0, 0, 0};
    var valid: [u8; 8] := {0, 0, 0, 0, 0, 0, 0, 0};
    var ops: [u8; 8] := {0, 0, 0, 0, 0, 0, 0, 0};
    var args: [u8; 8] := {0, 0, 0, 0, 0, 0, 0, 0};

    var idx: u8 := 0; // номер строки для запрошенного адреса
    var want: u8 := 0; // тег, который обязан лежать в строке
    var hits: u8 := 0; // счётчик попаданий
    var misses: u8 := 0; // счётчик промахов

    start Lookup {
        // Адрес уходит на шину заранее, ещё до решения «попадание или промах»:
        // при промахе ответ памяти будет здесь уже следующим тактом, а при
        // попадании он просто не нужен. ПОПАДАНИЕ обслуживается прямо тут, тем
        // же тактом: за этим кеш и ставят. Промах стоит такта и уходит в Miss.
        always {
            bus_addr := fetch_addr;
            idx := fetch_addr % 8;
            want := fetch_addr / 8;
            if enabled = 1 && fetch_req = 1 && valid[idx] = 1 && tags[idx] = want {
                fetch_op := ops[idx];
                fetch_arg := args[idx];
                fetch_ready := 1;
                hits := hits + 1;
            }
            else {
                fetch_ready := 0;
            }
        }
        ref Miss: fetch_req = 1 & enabled = 0;
        ref Miss: fetch_req = 1 & valid[idx] = 0;
        ref Miss: fetch_req = 1 & tags[idx] != want;
        ref Lookup;
    }

    // Промах: кеш выставляет запрос памяти и ЖДЁТ её ответа, а ядро ждёт кеша.
    state Miss {
        always {
            bus_req := 1;
            fetch_ready := 0;
        }
        ref Fill: bus_ready = 1;
        ref Miss;
    }

    // Ответ пришёл: строка заполняется (если кеш включён) и команда уходит ядру.
    state Fill {
        always {
            if enabled = 1 {
                ops[idx] := bus_op;
                args[idx] := bus_arg;
                tags[idx] := want;
                valid[idx] := 1;
            }
            fetch_op := bus_op;
            fetch_arg := bus_arg;
            fetch_ready := 1;
            misses := misses + 1;
            bus_req := 0;
        }
        ref Lookup;
    }
}

// ─── Ядро: последовательный машинный цикл ────────────────────────────────────
model Core {
    var pc: u8 := 0; // счётчик команд
    var acc: u8 := 0; // аккумулятор
    var op: u8 := 0; // текущий опкод
    var arg: u8 := 0; // текущий аргумент
    var next_pc: u8 := 0;

    // Выборка ждёт ответа: запрос снимается в том же такте, в котором ответ
    // принят, иначе кеш обслужит уже удовлетворённый запрос ещё раз.
    start Fetch {
        always {
            data_wen := 0;
            if fetch_ready = 1 {
                fetch_req := 0;
            }
            else {
                fetch_addr := pc;
                fetch_req := 1;
            }
        }
        ref Decode: fetch_ready = 1;
        ref Fetch;
    }

    // Команда пришла: разбираем и просим операнд по шине данных — ответ
    // понадобится уже следующим тактом.
    state Decode {
        always {
            op := fetch_op;
            arg := fetch_arg;
            data_addr := fetch_arg;
            next_pc := pc + 1;
        }
        ref Execute;
    }

    state Execute {
        always {
            match op {
                Lda => {
                    acc := data_rdata;
                }
                Sta => {
                    data_waddr := arg;
                    data_wdata := acc;
                    data_wen := 1;
                }
                Add => {
                    acc := acc + data_rdata;
                }
                Sub => {
                    acc := acc - data_rdata;
                }
                Jnz => {
                    if acc != 0 {
                        next_pc := arg;
                    }
                }
                _ => {}
            }
            pc := next_pc;
        }
        ref Halted: op = Hlt;
        ref Fetch;
    }

    state Halted;
}

var pipe_acc: u8 := 0; // аккумулятор конвейерного ядра

// ─── Конвейерное ядро: регистры между стадиями ───────────────────────────────
// IF/ID: что выбрала стадия выборки.
var if_op: u8 := 0;
var if_arg: u8 := 0;
var if_pc: u8 := 0;
var if_valid: bit := 0;

// ID/EX: что разобрала стадия декодирования.
var id_op: u8 := 0;
var id_arg: u8 := 0;
var id_pc: u8 := 0;
var id_valid: bit := 0;

// Что исполняется прямо сейчас — для наблюдения за занятостью стадий.
var ex_pc: u8 := 0;
var ex_valid: bit := 0;

// ─── Стадия 1: выборка ───────────────────────────────────────────────────────
model StageFetch {
    var pc: u8 := 0;

    start Run {
        // Сперва защёлкиваем ответ на запрос прошлого такта, затем просим
        // следующую команду: так стадия выдаёт по команде за такт. Переходов в
        // программе конвейерной ступени нет — как проводят через конвейер их,
        // раздел говорит текстом.
        always {
            if bus_ready = 1 {
                if_op := bus_op;
                if_arg := bus_arg;
                if_pc := bus_addr;
                if_valid := 1;
                bus_req := 0;
            }
            else {
                if_valid := 0;
            }
            bus_addr := pc;
            bus_req := 1;
            pc := pc + 1;
        }
        ref Drained: if_op = Hlt;
        ref Run;
    }

    // Выборка остановлена: команда останова уже ушла по конвейеру.
    state Drained {
        always {
            if_valid := 0;
            bus_req := 0;
        }
        ref Drained;
    }
}

// ─── Стадия 2: декодирование ─────────────────────────────────────────────────
model StageDecode {
    start Run {
        // Адрес операнда уходит на шину данных заранее: ответ памяти понадобится
        // следующей стадии уже в следующем такте.
        always {
            if if_valid = 1 {
                id_op := if_op;
                id_arg := if_arg;
                id_pc := if_pc;
                id_valid := 1;
                data_addr := if_arg;
            }
            else {
                id_valid := 0;
            }
        }
        ref Run;
    }
}

// ─── Стадия 3: исполнение ────────────────────────────────────────────────────
model StageExecute {
    start Run {
        always {
            data_wen := 0;
            ex_valid := id_valid;
            ex_pc := id_pc;
            if id_valid = 1 {
                match id_op {
                    Lda => {
                        pipe_acc := data_rdata;
                    }
                    Sta => {
                        data_waddr := id_arg;
                        data_wdata := pipe_acc;
                        data_wen := 1;
                    }
                    Add => {
                        pipe_acc := pipe_acc + data_rdata;
                    }
                    Sub => {
                        pipe_acc := pipe_acc - data_rdata;
                    }
                    _ => {}
                }
            }
        }
        ref Halted: id_op = Hlt;
        ref Run;
    }

    state Halted;
}
