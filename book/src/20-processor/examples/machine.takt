// Ступень 1: машина в сборе — ядро, кеш и память.
//
// Все части берутся из библиотеки; ступень задаёт только СБОРКУ. Здесь память
// быстрая (ответ за такт), а кеш выключен: ядро ходит на шину за каждой
// командой. Ступень 2 сменит два значения — и появится смысл кеша.
import {Op, Memory, Cache, Core, fetch_addr, fetch_req, fetch_op, fetch_arg, fetch_ready, bus_addr, bus_req, bus_op, bus_arg, bus_ready, data_addr, data_waddr, data_rdata, data_wdata, data_wen} from "machine_lib.takt";

start Machine = Core | Cache(enabled := 0) | Memory(latency := 0);
