// Кабина лифта: едет к целевому этажу и открывает двери по прибытии.
type Floor = u8; // псевдоним: имя вместо ширины
enum Direction {
    Up,
    Down,
    Idle
} // (1) перечисление направлений
struct Trip {
    origin: u8,
    dest: u8
}
// (2) структура: откуда и куда
in floor_sensor: u8; // текущий этаж от датчика
out motor: bit; // (3) привод (1 бит)
out door: bool; // (4) двери открыты/закрыты

const TOP: u8 := 9;

var direction: Direction := Idle;
var current: Floor := 1; // (5) псевдоним `Floor` — то же целое
var target: u8 := 5;
var speed: q(4, 4) := 0.0; // (6) фикс-точка: доля номинала
var log: [u8; 3] := {1, 1, 1}; // (7) массив последних этажей
var last: Trip := {1, 1};

start Waiting {
    enter {
        motor := 0;
        door := true;
        direction := Idle;
    }
    ref Moving: target > current;
}
// (8) сравнение этажей
state Moving {
    enter {
        direction := Up;
        door := false;
        motor := 1;
        speed := 1.0;
        last := {current, target};
    }
    always {
        current := floor_sensor;
        log[0] := current;
    }
    ref Waiting: current = target;
}
