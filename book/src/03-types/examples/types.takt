// Обзор системы типов на одной модели: примитивы, целые, перечисление,
// структура, фикс-точка и массив.

enum Mode { Idle = 0, Run = 1, Halt = 2 }   // (1)

struct Point {                               // (2)
    x: u16,
    y: u16
}

in start_btn: bit;                           // (3)
out active: bool;                            // (4)

const ORIGIN: Point := {0, 0};
const GAIN: q(4, 4) := 1.5;                  // (5)

var mode: Mode := Idle;
var counter: u16 := 0;                       // (6)
var level: q(4, 4) := 0.0;
var samples: [u8; 4] := {0, 0, 0, 0};        // (7)

start Idle {
    enter { active := false; mode := Idle; counter := ORIGIN.x; }
    ref Working: start_btn = 1;              // (8)
}

state Working {
    enter { active := true; mode := Run; }
    always {
        counter := counter + 1;
        level := level + GAIN;
        samples[0] := 1;
    }
    ref Idle: start_btn = 0;
}
