enum Mode { Slow, Fast, Stop }

in mode_in: u8;
out speed: u8;

var mode: Mode := Slow;
var ticks: u8 := 0;

fn ramp(target: u8) -> u8 {
    var v: u8 := 0;
    while v < target {          // (4) цикл while
        v := v + 1;
        if v >= 100 {
            break;              // (5) досрочный выход
        }
    }
    return v;                   // (6) возврат из функции
}

start Running {
    always {
        match mode {            // (1) выбор по перечислению
            Slow => {
                speed := ramp(20);
            }
            Fast => {
                speed := ramp(80);
            }
            _ => {
                speed := 0;
            }
        }
        for var i: u8 := 0; i < 3; i := i + 1 {   // (2) цикл со счётчиком
            ticks := ticks + 1;
        }
        if ticks > 200 {        // (3) ветвление
            ticks := 0;
        }
        else {
            ticks := ticks;
        }
    }
    ref Running: mode_in = 0;
}
