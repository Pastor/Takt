// Сортировочный конвейер: как только деталь доезжает до развилки, определяет её
// класс, направляет в нужный лоток и наращивает счёт обслуженных деталей,
// сообщая число набранных паллет.
enum Item {
    Small,
    Large,
    Reject
}

in part_ready: bit; // деталь доехала до развилки
in class_code: u8; // код класса от датчика
out gate: u8; // номер лотка (0 — брак)
out belt: bit;
out pallet_count: u8; // сколько паллет уже набрано

const PALLET: u8 := 24; // деталей в одной паллете

var kind: Item := Reject;
var count: u8 := 0;

start Waiting {
    enter {
        belt := 1;
        gate := 0;
    }
    ref Sorting: part_ready = 1;
}

state Sorting {
    enter {
        if class_code = 0 {
            // (1) определить класс по коду датчика
            kind := Small;
        } else {
            if class_code = 1 {
                kind := Large;
            } else {
                kind := Reject;
            }
        }
        match kind {
            Small => {
                // (2) направить деталь в лоток по классу
                gate := 1;
            }
            Large => {
                gate := 2;
            }
            _ => {
                gate := 0;
            }
        }
        count := count + 1; // (3) учесть обслуженную деталь
        pallet_count := pallets(count);
    }
    ref Waiting: part_ready = 0;
}

// Сколько полных паллет умещается в total деталей (деление повторным вычитанием).
fn pallets(total: u8) -> u8 {
    var p: u8 := 0;
    var t: u8 := total;
    while t >= PALLET {
        // (4) цикл while
        t := t - PALLET;
        p := p + 1;
        if p >= 100 {
            break; // (5) страховочный досрочный выход
        }
    }
    return p; // (6) возврат из функции
}
