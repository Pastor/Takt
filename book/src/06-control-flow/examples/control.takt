// Сортировочный конвейер: направляет деталь в лоток по её классу и ведёт счёт
// обработанных деталей.

enum Item { Small, Large, Reject }

in sensor: u8;
in class_off: u8;
out gate: u8;
out belt: bit;

var counter: u8 := 0;
var kind: Item := Small;

// Отсчитывает такты стабилизации детали, но не дольше предела.
fn settle(target: u8) -> u8 {
    var t: u8 := 0;
    while t < target {          // (4) цикл while
        t := t + 1;
        if t >= 50 { break; }   // (5) досрочный выход
    }
    return t;                   // (6) возврат из функции
}

start Running {
    enter { belt := 1; }
    always {
        match kind {            // (1) выбор ветви по классу детали
            Small => { gate := 1; }
            Large => { gate := 2; }
            _ => { gate := 0; }
        }
        counter := settle(sensor);
        for var i: u8 := 0; i < 3; i := i + 1 {   // (2) цикл со счётчиком
            counter := counter + 1;
        }
        if counter > 100 {      // (3) ветвление
            counter := 0;
        }
        else {
            counter := counter;
        }
    }
    ref Running: class_off = 0;
}
