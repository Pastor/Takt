// Условия используют & | ! как логические; выражения — арифметику,
// присваивание := и сравнение =.
const LIMIT: u8 := 100;

in start_btn: bit;
in stop_btn: bit;
out running: bit;

var count: u8 := 0;
var doubled: u8 := 0;

start Idle {
    enter {
        running := 0;
        count := 0;
    }
    ref Working: start_btn = 1 & stop_btn = 0;   // (1) логическое И в условии
}

state Working {
    enter {
        running := 1;
    }
    always {
        count := count + 1;         // (2) присваивание :=
        doubled := count * 2;       // (3) арифметика
        if count >= LIMIT {         // (4) сравнение в условии
            count := 0;
        }
    }
    ref Idle: stop_btn = 1 | count >= LIMIT;      // (5) логическое ИЛИ
}
