// Бойлер: греет воду, когда она остыла и давление в норме; выключает нагрев
// при достижении верхнего порога или падении давления.

const MAX_TEMP: u8 := 90;
const MIN_TEMP: u8 := 60;

in temp: u8;
in pressure_ok: bit;
out heater: bit;

var cycles: u8 := 0;

start Idle {
    enter { heater := 0; }
    ref Heating: temp < MIN_TEMP & pressure_ok = 1;   // (1) логическое И в условии
}

state Heating {
    enter { heater := 1; }
    always { cycles := cycles + 1; }                  // (2) присваивание и арифметика
    ref Idle: temp >= MAX_TEMP | pressure_ok = 0;     // (3) логическое ИЛИ
}
