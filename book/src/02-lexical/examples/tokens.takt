// Строчный комментарий. Таймер с порогом демонстрирует лексику языка:
// идентификаторы, литералы, комментарии, операторы и пунктуацию.

/// Документационный комментарий (начинается с `///`) — относится к следующему
/// объявлению. Десятичный литерал допускает разделитель разрядов `_`.
const LIMIT: u16 := 1_000;
/// Шестнадцатеричный литерал записывается с префиксом `0x`.
const STEP: u16 := 0x0001;

in tick: bit;
out done: bit;

var count: u16 := 0;

start Counting {
    enter { count := 0; done := 0; }

    /* Блочный комментарий: пока порог не достигнут, по каждому tick
       увеличиваем счётчик. Оператор `:=` — присваивание, `=` — равенство. */
    always {
        if tick = 1 {
            count := count + STEP;
        }
    }

    ref Done: count >= LIMIT;
}

state Done {
    enter { done := 1; }
}
