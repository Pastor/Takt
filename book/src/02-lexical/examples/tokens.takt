// Таймер с порогом. Это строчный комментарий (1).

/// Документационный комментарий (2) — относится к следующему объявлению.
const LIMIT: u16 := 1_000;   // (3) десятичный литерал, разделитель разрядов _
const STEP: u16 := 0x0001;   // (4) шестнадцатеричный литерал

in tick: bit;
out done: bit;

var count: u16 := 0;

start Counting {
    enter { count := 0; done := 0; }
    /* Блочный комментарий (5) может занимать несколько строк. */
    always {
        if tick = 1 {
            count := count + STEP;   // (6) := присваивает, = сравнивает
        }
    }
    ref Done: count >= LIMIT;
}

state Done {
    enter { done := 1; }
}
