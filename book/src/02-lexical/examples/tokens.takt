// Термореле замыкает силовую нагрузку, пока температура ниже порога, и
// размыкает её при перегреве. Это строчный комментарий. (1)

/// Порог срабатывания, °C. Документационный комментарий над объявлением. (2)
const MAX_TEMP: u8 := 80; // (3) десятичный литерал
const HYST: u8 := 5; // гистерезис возврата

in temp: u8;
out load: bit;

start Heating {
    enter {
        load := 1;
    }
    /* Пока порог не достигнут, нагрузка включена. Это блочный комментарий. (4) */
    ref Cooling: temp >= MAX_TEMP;
}

state Cooling {
    enter {
        load := 0; // (5) := присваивает, = сравнивает
    }
    ref Heating: temp <= MAX_TEMP - HYST;
}
