// Насосная станция: по запросу включает насос и удерживает давление, не давая
// ему превысить допустимый предел.

extern fn read_pressure() -> u8;   // (1) внешняя функция: чтение датчика
extern fn drive_pump(on: bit);     //     внешняя функция: команда насосу

in demand: bit;
out running: bit;
out margin: u8;

const MAX_P: u8 := 100;

var pressure: u8 := 0;

fn clamp(p: u8) -> u8 {             // (2) ограничение сверху
    if p > MAX_P {
        return MAX_P;
    }
    return p;
}

fn headroom(p: u8) -> u8 {          // (3) композиция: headroom использует clamp
    return MAX_P - clamp(p);
}

start Off {
    enter { running := 0; drive_pump(0); }
    ref On: demand = 1;
}

state On {
    enter { running := 1; drive_pump(1); }             // (5) вызов внешней функции
    always {
        pressure := clamp(read_pressure());            // (4) вызов над результатом внешней
        margin := headroom(pressure);
    }
    ref Off: demand = 0;
}
