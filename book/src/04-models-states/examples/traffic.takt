// Светофор: три состояния по кругу, переключение по таймеру.

out red: bit;
out yellow: bit;
out green: bit;

var timer: u8 := 0;

start Red {                 // (1) стартовое состояние
    enter {                 // (2) при входе
        red := 1;
        yellow := 0;
        green := 0;
        timer := 0;
    }
    always {                // (3) каждый такт
        timer := timer + 1;
    }
    ref Green: timer >= 30; // (4) переход по условию
}

state Green {               // (5) обычное состояние
    enter {
        red := 0;
        green := 1;
        timer := 0;
    }
    always {
        timer := timer + 1;
    }
    ref Yellow: timer >= 30;
}

state Yellow {              // (6)
    enter {
        green := 0;
        yellow := 1;
        timer := 0;
    }
    always {
        timer := timer + 1;
    }
    ref Red: timer >= 5;
}
