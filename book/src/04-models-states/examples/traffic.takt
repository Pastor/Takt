// Светофор: три состояния по кругу, переключение по таймеру.
// Демонстрирует стартовое состояние, переходы ref и блоки enter/always.
out red: bit;
out yellow: bit;
out green: bit;

var timer: u8 := 0;

// Ровно одно стартовое состояние — с него начинается работа автомата.
start Red {
    enter {
        red := 1;
        yellow := 0;
        green := 0;
        timer := 0;
    }
    always {
        timer := timer + 1;
    }
    ref Green: timer >= 30;
}

state Green {
    enter {
        red := 0;
        green := 1;
        timer := 0;
    }
    always {
        timer := timer + 1;
    }
    ref Yellow: timer >= 30;
}

state Yellow {
    enter {
        green := 0;
        yellow := 1;
        timer := 0;
    }
    always {
        timer := timer + 1;
    }
    ref Red: timer >= 5;
}
