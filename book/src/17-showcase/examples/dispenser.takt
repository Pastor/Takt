// Дозатор: наполняет ёмкость до целевого уровня, сигналит готовность и
// сбрасывается. Демонстрирует состояния, переходы, инвариант-guard.
const TARGET: u8 := 100;
const STEP: u8 := 20;

out pump: bit;
out ready: bit;

var level: u8 := 0;

// Инвариант безопасности: уровень не превышает целевой (проверяется симулятором).
invariant SafeLevel = level <= TARGET;

start Idle {
    enter {
        pump := 0;
        ready := 0;
        level := 0;
    }
    next Filling;
}

state Filling {
    enter {
        pump := 1;
    }
    always {
        level := level + STEP;
    }
    ref Ready: level >= TARGET;
}

state Ready {
    enter {
        pump := 0;
        ready := 1;
    }
    next Idle;
}
