<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE language SYSTEM "language.dtd">
<!--
  Определение подсветки синтаксиса языка Takt в формате KDE/kate.
  Используется skylighting (движок pandoc) при сборке документа book/ в PDF:
  фрагменты кода в блоках ```takt подсвечиваются согласно этому файлу
  (подключение — опция syntax-definitions в book.toml).

  Ключевые слова и типы соответствуют лексеру языка
  (takt-lang/src/parser/lexer.rs, таблица KEYWORDS). При изменении набора
  ключевых слов языка этот файл правится синхронно.
-->
<language name="Takt" version="1" kateversion="5.0" section="Sources"
          extensions="*.takt" mimetype="text/x-takt"
          author="Pastor" license="BSD" casesensitive="1">
  <highlighting>
    <list name="keywords">
      <item>model</item>
      <item>state</item>
      <item>start</item>
      <item>ref</item>
      <item>next</item>
      <item>cond</item>
      <item>invariant</item>
      <item>enter</item>
      <item>exit</item>
      <item>always</item>
      <item>fn</item>
      <item>extern</item>
      <item>return</item>
      <item>if</item>
      <item>else</item>
      <item>match</item>
      <item>while</item>
      <item>loop</item>
      <item>for</item>
      <item>break</item>
      <item>continue</item>
      <item>in</item>
      <item>out</item>
      <item>inout</item>
      <item>address</item>
      <item>import</item>
      <item>from</item>
      <item>as</item>
      <item>type</item>
      <item>enum</item>
      <item>struct</item>
      <item>const</item>
      <item>var</item>
      <item>formula</item>
      <item>assembly</item>
    </list>
    <list name="types">
      <item>bool</item>
      <item>bit</item>
      <item>u8</item>
      <item>u16</item>
      <item>u32</item>
      <item>u64</item>
      <item>i8</item>
      <item>i16</item>
      <item>i32</item>
      <item>i64</item>
      <item>float</item>
      <item>rational</item>
      <item>q</item>
    </list>
    <list name="constants">
      <item>true</item>
      <item>false</item>
    </list>
    <contexts>
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <Detect2Chars attribute="Comment" context="LineComment" char="/" char1="/"/>
        <keyword attribute="Keyword" context="#stay" String="keywords"/>
        <keyword attribute="Data Type" context="#stay" String="types"/>
        <keyword attribute="Constant" context="#stay" String="constants"/>
        <DetectChar attribute="String" context="String" char="&quot;"/>
        <HlCHex attribute="Number" context="#stay"/>
        <Float attribute="Number" context="#stay"/>
        <Int attribute="Number" context="#stay"/>
        <RegExpr attribute="Operator" context="#stay" String=":=|==|&lt;=|&gt;=|-&gt;|=&gt;|&amp;&amp;|\|\||[-+*/%&lt;&gt;=!&amp;|^~]"/>
      </context>
      <context name="LineComment" attribute="Comment" lineEndContext="#pop"/>
      <context name="String" attribute="String" lineEndContext="#pop">
        <HlCStringChar attribute="String Char" context="#stay"/>
        <DetectChar attribute="String" context="#pop" char="&quot;"/>
      </context>
    </contexts>
    <itemDatas>
      <itemData name="Normal Text" defStyleNum="dsNormal"/>
      <itemData name="Keyword"     defStyleNum="dsKeyword"    bold="1"/>
      <itemData name="Data Type"   defStyleNum="dsDataType"/>
      <itemData name="Constant"    defStyleNum="dsConstant"/>
      <itemData name="Comment"     defStyleNum="dsComment"    italic="1"/>
      <itemData name="String"      defStyleNum="dsString"/>
      <itemData name="String Char" defStyleNum="dsSpecialChar"/>
      <itemData name="Number"      defStyleNum="dsDecVal"/>
      <itemData name="Operator"    defStyleNum="dsOperator"/>
    </itemDatas>
  </highlighting>
  <general>
    <comments>
      <comment name="singleLine" start="//"/>
    </comments>
    <keywords casesensitive="1"/>
  </general>
</language>
