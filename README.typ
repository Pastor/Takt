= Часть 15. Примеры программ

=== Минимальный конечный автомат

```lam
model Minimal {
    start Idle;
    state Active;
    state Done;
}

start Main = Minimal;
```

=== Светофор с таймером

```lam
type u8 = [bit;8];

model TrafficLight {
    var timer: u8 = 0;

    start Red {
        enter  { timer = 0; }
        always { timer = timer + 1; }
        ref Green: timer = 255;
    }

    state Green {
        enter  { timer = 0; }
        always { timer = timer + 1; }
        ref Yellow: timer = 100;
    }

    state Yellow {
        enter  { timer = 0; }
        always { timer = timer + 1; }
        ref Red: timer = 50;
    }
}

start Entry = TrafficLight;
```

=== Кнопка и светодиод (порты, внешние функции)

```lam
type u8 = [bit;8];

extern fn debug(msg: u8);

fn toggle(val: u8) -> u8 {
    return ~val;
}

model ButtonLED {
    var state: u8 = 0;

    in  BTN: bit;     // входной порт — кнопка
    out LED: u8;      // выходной порт — светодиод

    start Idle {
        ref Active: BTN = 1;
    }

    state Active {
        enter {
            state = toggle(state);
            LED   = state;
            debug(state);
        }
        next Idle;
    }
}

start M = ButtonLED;
```

=== Управление лифтом (параллельная композиция, направленные порты)

Файл `examples/elevator_mini.but` --- 9-этажная модель с параллельными автоматами Motor и Cabin:

```lam
type u8 = [bit;8];

enum Command { Up, Down, Stop }

var command:       Command = Stop;
var current_floor: u8      = 1;
var target_floor:  u8      = 0;

model Motor {
    start Idle {
        ref Up:   command = Up;
        ref Down: command = Down;
        enter { ElevatorMotor_Stop = true; }
    }
    state Up {
        ref Stop: command = Stop | ElevatorMotor_SensorU;
        always   { ElevatorMotor_Up = true; }
    }
    state Down {
        ref Stop: command = Stop | ElevatorMotor_SensorD;
        always   { ElevatorMotor_Down = true; }
    }
    state Stop {
        next Idle;
        always { ElevatorMotor_Stop = true; }
    }

    out ElevatorMotor_Up:      bit;
    out ElevatorMotor_Down:    bit;
    out ElevatorMotor_Stop:    bit;
    in  ElevatorMotor_SensorU: bit;
    in  ElevatorMotor_SensorD: bit;
}

// model Cabin { ... } — см. examples/elevator_mini.but

start Main = Cabin | Motor;   // параллельный запуск
```

