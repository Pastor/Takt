/* Пример использования блочного комментария в языке Takt.
   Блочный комментарий может занимать несколько строк.
   Используется для временного отключения больших фрагментов кода
   или для детальной документации. */

/* Однострочный блочный комментарий */
var enabled: bit = true;

/*
 * Модель светофора с таймером.
 * Состояния: Red, Green, Yellow.
 */
model Traffic {
    /* Константа: длительность красного сигнала в тактах */
    const RED_DURATION: bit = 60;

    start Red {
        /* Ждём истечения таймера перед переходом */
        ref Green: enabled = 1; /* переход разрешён */
    }

    Green {
        ref Yellow: enabled = 1;
    }

    Yellow {
        ref Red: enabled = 1; /* возврат к красному */
    }
}
