// Общая библиотека вне каталога документа. Разрешается только через searchPaths.
model Shared {
    start Idle { ref Idle; }
}

// Корень файла обязан иметь состояние: `import` вносит модель по имени ФАЙЛА, и
// без этой строки `start Main = Shared;` у документа ссылался бы на обёртку без
// состояний — `SE-106` (фича 0211).
start Root = Shared;
