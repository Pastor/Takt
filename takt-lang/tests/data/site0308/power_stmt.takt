// Возведение в степень над переменными: не переводят `rust` и `sv`.
// Массивов здесь нет намеренно — иначе цель `sv` отказала бы раньше, на
// инициализаторе, и координата оператора осталась бы непроверенной.
var n: u8 := 0;
var p: u8 := 0;

out probe: u8 at 0;

start Run {
    always {
        n := n + 1;
        p := n ** 2;
        probe := p;
    }
    ref Run: n < 100;
}
