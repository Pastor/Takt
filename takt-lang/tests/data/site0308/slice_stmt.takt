// Срез массива в ТЕЛЕ состояния: цели `c`, `rust` и `st` его не переводят.
// Позиция отказа обязана указывать на строку оператора, а не на объявление
// операнда и не в пустоту (фича 0308).
var mem: [u8; 4] := {1, 2, 3, 4};
var res: [u8; 2] := {0, 0};
var n: u8 := 0;

out probe: u8 at 0;

start Run {
    always {
        n := n + 1;
        res := mem[1:2];
        probe := n;
    }
    ref Run: n < 100;
}
