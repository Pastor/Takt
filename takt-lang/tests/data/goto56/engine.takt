// Цель перехода для КОНТРПРИМЕРА: импортируется под алиасом `Motor`.
// Модель называется Engine, файл — engine.takt, а в импортирующем файле имя
// модели — Motor. Угадывание искало бы motor.takt и не нашло бы ничего.
model Engine {
    var rpm: u8 := 0;

    start Stopped { ref Stopped; }
}

// Корень файла обязан иметь состояние — см. helper.takt (фича 0211). Строка
// объявления `model Engine` при этом не сдвигается: на неё опирается зонд T8.
start Root = Engine;
