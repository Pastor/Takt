// Общая библиотека для тестов выборочного импорта.
//
// Содержит по одному объекту каждой категории:
// - модель SharedModel
// - псевдоним типа SharedType
// - переменная shared_var
// - условие SharedCond

type SharedType = [bit; 4];

var shared_var: bit := false;

cond SharedCond = true;

model SharedModel {
    start S;
}
