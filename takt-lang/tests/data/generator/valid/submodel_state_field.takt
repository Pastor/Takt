/// Тестовый файл: проверка, что переменные вложенной модели в функциях
/// генерируются через имя состояния-контейнера, а не через имя модели.
///
/// Модель Controller инстанциируется как состояние Entry.
/// Поле в C-структуре называется `entry`, а не `controller`.

model Controller {
    var temperature: u8 := 0;
    const MAX_TEMP: u8 := 100;

    /// Ограничивает значение диапазоном [temperature, MAX_TEMP]
    fn clamp_temp(value: u8) -> u8 {
        if value > MAX_TEMP { return MAX_TEMP; }
        if value < temperature { return temperature; }
        return value;
    }

    start Idle { }
}

start Entry = Controller;
