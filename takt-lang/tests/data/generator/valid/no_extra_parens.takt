/// Тестовый файл: проверка минимизации скобок при генерации C-кода.
/// В Takt условие if/while пишется без скобок (как в Rust).

fn clamp_temp(value: u8) -> u8 {
    if value > 100 {
        return 100;
    }
    return value;
}

fn add_mul(a: u8, b: u8, c: u8) -> u8 {
    return a + b * c;
}

start Main { always { } }
