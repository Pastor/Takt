// Фича 0049: то же свойство НАРУШЕНО — контрпример.
//
// Отличие от holds.lam ровно одно: у Fault есть самопетля `ref Fault`.
// Прогон Idle -> Fault -> Fault -> ... остаётся в сбое навсегда и в Idle не
// возвращается, поэтому G (Fault -> F Idle) ложно.
// Контрпример: Idle -> [ Fault ]*
: [LTL] G (Fault -> F Idle);

var error: bit := false;

start Idle {
    ref Fault: error = 1;
}

state Fault {
    ref Fault: error = 1;
    ref Idle: error = 0;
}
