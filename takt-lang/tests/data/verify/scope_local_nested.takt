// Фича 0051, контрпример к сужению области: ЛОКАЛЬНАЯ вложенная модель с
// нарушенным свойством проверяется ВСЕГДА.
//
// Пара к scope_plain.takt: там нарушитель пришёл извне и отсекается, здесь он
// свой — и обязан дать код 1 при любой области. Без этой фикстуры «сужение»
// нельзя отличить от «перестали проверять вложенные модели вообще».
model Engine {
    : [LTL] G (Broken -> F Run);

    start Run { ref Broken; }
    state Broken { ref Broken; ref Run; }
}

start Main = Engine;
