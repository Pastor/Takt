// Псевдонимы типов (позитивный тест парсера)
type bit1  = bit;
type Byte    = [bit;8];
type Word   = [bit;16];
type DWord   = [bit;32];
type QWord   = [bit;64];

// Константы с псевдонимами типов
const ZERO: Byte  := 0;
const MAX:  Byte  := 0xFF;
const MASK: Word := 0x0F;

model M {
    start S;
}
