// Компоновка моделей: последовательная (+) и параллельная (|) (позитивный тест)

model A {
    start S1;
    state S2;
}

model B {
    start T1;
    state T2;
}

model C {
    start U1;
}

// Последовательная компоновка: A затем B
start SeqAB = A + B;

// Параллельная компоновка: A и B одновременно
// start ParAB = A | B;

// Вложенная компоновка: (A | B) + C
// start Complex = (A | B) + C;
