// Пример: конечный автомат мигалки светодиода (позитивный тест)
// Демонстрирует: псевдонимы типов, порты, условия, именованные блоки, переходы


out LED:     u8 at 0x00100000;
in BUTTON:  bit at 0x00200000:0;

var counter: u8 := 0;

cond ButtonPressed = BUTTON = true;
cond LimitReached  = counter = 100;

model Blinker {
    start On {
        ref Off: LimitReached;
        enter {
            LED := 0xFF;
            counter := 0;
        }
        exit {
            LED := 0x00;
        }
        always {
            counter := counter + 1;
        }
    }
    state Off {
        ref On: ButtonPressed;
        enter {
            LED := 0x00;
            counter := 0;
        }
    }
}

start Main = Blinker;
