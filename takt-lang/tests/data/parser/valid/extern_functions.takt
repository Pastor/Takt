// Внешние функции и обычные функции (позитивный тест)
// Демонстрирует: extern fn, fn с параметрами и возвратом, fn без тела

type u8 = [bit;8];

// Внешняя функция без тела
extern fn hal_init();

// Внешняя функция с параметрами и возвратом
extern fn hal_read(addr: u8) -> u8;

// Обычная функция с телом
fn add(a: u8, b: u8) -> u8 {
    return a + b;
}

// Функция без возвращаемого значения
fn reset(x: u8) {
    x := 0;
}

model M {
    start Ready {
        enter {
            hal_init();
        }
    }
}
