// Ce5: Состояние имеет и ref, и next одновременно.
//
// Правило Ce5.3: наличие next делает код после него недостижимым,
// если ref-переходы стоят вместе с next.
// Ожидается: предупреждение о недостижимости.

model M {
    start S;
}

start A = M {
    ref B: true;
    next C;
}
state B;
state C;
