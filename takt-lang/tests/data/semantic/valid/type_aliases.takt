// Пример: псевдонимы типов, переменные и порты.
//
// Проверяет:
// - объявление псевдонимов Byte и Word
// - переменная counter с типом Byte
// - порт STATUS с аппаратным адресом

type Byte  = [bit; 8];
type Word = [bit; 16];

var   counter: Byte  := 0;
in STATUS:  Byte at 0x40000000;

start Idle {
    ref Done: true;
}
state Done;
