/// Тест: вызов extern функции после объявления локальной переменной.
/// Проверяет, что локальная переменная не ломает разрешение extern fn.


extern fn log_value(v: u8);

model Counter {
    var x: u8 := 0;

    start Running {
        always {
            var delta: u8 := 1;
            x := x + delta;
            log_value(x);
        }
    }
}

start Root = Counter;
