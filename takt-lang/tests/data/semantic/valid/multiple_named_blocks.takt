// Пример с несколькими именованными блоками одного типа.
// Это может быть полезно для разделения логики на несколько независимых частей.

var a: bit := false;
var b: bit := false;
var counter: [bit; 8] := 0;

// Первый блок always
always {
    a := !a;
}

// Второй блок always
always {
    b := !b;
}

// Третий блок always
always {
    counter := counter + 1;
}

start Initial {
    enter {
        a := false;
    }
    // Второй блок enter в том же состоянии
    enter {
        b := false;
    }

    exit {
        // Логика при выходе
    }
    // Второй блок exit
    exit {
        counter := 0;
    }
}
