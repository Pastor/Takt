// Фикстура фичи 0213: условное ребро и терминальное состояние.
//
// Контр-пример к правке: у условного ребра `break;` ОБЯЗАТЕЛЕН — он выходит из
// `switch` изнутри блока `if`. Терминальное состояние (`Stop`, рёбер нет)
// получает `model->state = <МОДЕЛЬ>_END;` и закрывающий `break;` ветви.
var n: u8 := 0;

start Wait {
    always {
        n := n + 1;
    }
    ref Stop: n = 2;
}

state Stop {
    always {
        n := 0;
    }
}
