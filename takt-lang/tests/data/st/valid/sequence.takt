// 0041-07: последовательная композиция A + B.
//
// ⚠ Файл называется sequence, а не concat, НАМЕРЕННО: имя корневой модели берётся
// из имени файла, а `CONCAT` — СТАНДАРТНАЯ функция IEC 61131-3 (склейка строк).
// `FUNCTION_BLOCK Concat` транспилятор отвергает: «invalid function block name in
// function block declaration». Пространство имён POU и стандартной библиотеки —
// общее.
//
// В отличие от параллели, шаги идут ПО ОЧЕРЕДИ: у конкатенации свой счётчик
// шагов (в цели c — вложенный enum state), в ST — вложенный CASE.

model A {
    var a: u8 := 0;
    start Q { always { a := a + 1; } }
}

model B {
    var b: u8 := 0;
    start R { always { b := b + 1; } }
}

start Chain = A + B;
