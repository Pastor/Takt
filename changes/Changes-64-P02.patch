+fn expand(
+    mut new: BTreeSet<Rc<Ltl>>,
+    mut old: BTreeSet<Rc<Ltl>>,
+    mut next: BTreeSet<Rc<Ltl>>,
+    incoming: BTreeSet<Option<usize>>,
+    nodes: &mut Vec<GbaNode>,
+    node_map: &mut BTreeMap<(BTreeSet<Rc<Ltl>>, BTreeSet<Rc<Ltl>>), usize>,
+    transitions: &mut BTreeSet<(usize, usize)>,
+    initial_nodes: &mut BTreeSet<usize>,
+) {
+    if new.is_empty() {
+        let key = (old.clone(), next.clone());
+        let id = if let Some(&id) = node_map.get(&key) {
+            id
+        } else {
+            let id = nodes.len();
+            nodes.push(GbaNode { old, next });
+            node_map.insert(key, id);
+
+            let next_new = nodes[id].next.clone();
+            let mut next_inc = BTreeSet::new();
+            next_inc.insert(Some(id));
+            expand(
+                next_new,
+                BTreeSet::new(),
+                BTreeSet::new(),
+                next_inc,
+                nodes,
+                node_map,
+                transitions,
+                initial_nodes,
+            );
+            id
+        };
+
+        for inc in incoming {
+            if let Some(from_id) = inc {
+                transitions.insert((from_id, id));
+            } else {
+                initial_nodes.insert(id);
+            }
+        }
+        return;
+    }
+
+    let f = new.pop_first().unwrap();
+    if f.as_ref() == &Ltl::True {
+        expand(
+            new,
+            old,
+            next,
+            incoming,
+            nodes,
+            node_map,
+            transitions,
+            initial_nodes,
+        );
+    } else if f.as_ref() == &Ltl::False {
+        return;
+    } else {
+        match f.as_ref() {
+            Ltl::Atom(_) | Ltl::Not(_) => {
+                let neg_f = match f.as_ref() {
+                    Ltl::Atom(a) => Rc::new(Ltl::Not(Rc::new(Ltl::Atom(a.clone())))),
+                    Ltl::Not(inner) => inner.clone(),
+                    _ => unreachable!(),
+                };
+                if old.contains(&neg_f) {
+                    return;
+                }
+                old.insert(f);
+                expand(
+                    new,
+                    old,
+                    next,
+                    incoming,
+                    nodes,
+                    node_map,
+                    transitions,
+                    initial_nodes,
+                );
+            }
+            Ltl::And(f1, f2) => {
+                new.insert(f1.clone());
+                new.insert(f2.clone());
+                expand(
+                    new,
+                    old,
+                    next,
+                    incoming,
+                    nodes,
+                    node_map,
+                    transitions,
+                    initial_nodes,
+                );
+            }
+            Ltl::Or(f1, f2) => {
+                let mut new1 = new.clone();
+                new1.insert(f1.clone());
+                expand(
+                    new1,
+                    old.clone(),
+                    next.clone(),
+                    incoming.clone(),
+                    nodes,
+                    node_map,
+                    transitions,
+                    initial_nodes,
+                );
+                new.insert(f2.clone());
+                expand(
+                    new,
+                    old,
+                    next,
+                    incoming,
+                    nodes,
+                    node_map,
+                    transitions,
+                    initial_nodes,
+                );
+            }
+            Ltl::Next(f1) => {
+                next.insert(f1.clone());
+                expand(
+                    new,
+                    old,
+                    next,
+                    incoming,
+                    nodes,
+                    node_map,
+                    transitions,
+                    initial_nodes,
+                );
+            }
+            Ltl::Until(f1, f2) => {
+                let mut new1 = new.clone();
+                new1.insert(f2.clone());
+                expand(
+                    new1,
+                    old.clone(),
+                    next.clone(),
+                    incoming.clone(),
+                    nodes,
+                    node_map,
+                    transitions,
+                    initial_nodes,
+                );
+                new.insert(f1.clone());
+                next.insert(f.clone());
+                expand(
+                    new,
+                    old,
+                    next,
+                    incoming,
+                    nodes,
+                    node_map,
+                    transitions,
+                    initial_nodes,
+                );
+            }
+            Ltl::Release(f1, f2) => {
+                let mut new1 = new.clone();
+                new1.insert(f1.clone());
+                new1.insert(f2.clone());
+                expand(
+                    new1,
+                    old.clone(),
+                    next.clone(),
+                    incoming.clone(),
+                    nodes,
+                    node_map,
+                    transitions,
+                    initial_nodes,
+                );
+                new.insert(f2.clone());
+                next.insert(f.clone());
+                expand(
+                    new,
+                    old,
+                    next,
+                    incoming,
+                    nodes,
+                    node_map,
+                    transitions,
+                    initial_nodes,
+                );
+            }
+            _ => unreachable!("Formula not in NNF: {:?}", f),
+        }
+    }
+}
