  +            }
  +        }
  +    }
  +
  +    drop(borrowed);
  +    let nested: Vec<_> = model.borrow().models.values().map(Rc::clone).collect();
  +    for m in nested {
  +        collect_unreachable_states(&m, out);
  +    }
  +}
