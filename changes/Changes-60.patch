+/// Позитивный пример: `DEAD` объявлена, но нигде не используется —
+/// `CONST_FSM_DEAD` должна отсутствовать в `.c`-файле.
+///
+/// Контр-пример: `LIVE` используется в always, она должна присутствовать.
+#[test]
+fn unused_const_excluded() {
+    let src = r#"
+type u8 = [bit;8];
+const DEAD: u8 = 42;
+const LIVE: u8 = 7;
