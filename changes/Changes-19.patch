+    pub fn search_enum_variant(&self, variant_name: &str) -> Option<(String, i64)> {
+        for (enum_name, enum_node) in &self.enums {
+            if let Some(val) = enum_node.find_variant(variant_name) {
+                return Some((enum_name.clone(), val));
