  +fn eval_condition_const(cond: &ConditionNode, loc: Location, out: &mut Vec<Diagnostic>) {
  +    match eval_const_value(cond) {
  +        Some(true) => {
  +            out.push(
  +                Diagnostic::warning(
  +                    loc,
  +                    "условие перехода всегда истинно — переход безусловный".to_string(),
  +                )
  +                .with_code("SE-047"),
