  +        }
  +        Some(false) => {
  +            out.push(
  +                Diagnostic::warning(
  +                    loc,
  +                    "условие перехода всегда ложно — переход недостижим".to_string(),
  +                )
  +                .with_code("SE-047"),
  +            );
  +        }
  +        None => {}
  +    }
  +}
