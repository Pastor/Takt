+    ELEVATOR_MINI_CABIN_FLOOR_SENSOR_F2_TOP = 23,
+    ELEVATOR_MINI_CABIN_FLOOR_SENSOR_F3_BOTTOM = 24,
+    ELEVATOR_MINI_CABIN_FLOOR_SENSOR_F3_TOP = 25,
+    ELEVATOR_MINI_CABIN_FLOOR_SENSOR_F4_BOTTOM = 26,
+    ELEVATOR_MINI_CABIN_FLOOR_SENSOR_F4_TOP = 27,
+    ELEVATOR_MINI_CABIN_FLOOR_SENSOR_F5_BOTTOM = 28,
