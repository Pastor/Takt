+    ELEVATOR_MINI_CABIN_CABIN_BUTTON_F9 = 10,
+    ELEVATOR_MINI_CABIN_FLOOR_BUTTON_F1 = 11,
+    ELEVATOR_MINI_CABIN_FLOOR_BUTTON_F2 = 12,
+    ELEVATOR_MINI_CABIN_FLOOR_BUTTON_F3 = 13,
+    ELEVATOR_MINI_CABIN_FLOOR_BUTTON_F4 = 14,
+    ELEVATOR_MINI_CABIN_FLOOR_BUTTON_F5 = 15,
+    ELEVATOR_MINI_CABIN_FLOOR_BUTTON_F6 = 16,
+    ELEVATOR_MINI_CABIN_FLOOR_BUTTON_F7 = 17,
+    ELEVATOR_MINI_CABIN_FLOOR_BUTTON_F8 = 18,
+    ELEVATOR_MINI_CABIN_FLOOR_BUTTON_F9 = 19,
+    ELEVATOR_MINI_CABIN_FLOOR_SENSOR_F1_BOTTOM = 20,
