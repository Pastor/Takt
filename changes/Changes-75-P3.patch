+
+/* Forward declarations */
+typedef struct ElevatorMiniMotor ElevatorMiniMotor;
+typedef struct ElevatorMiniCabin ElevatorMiniCabin;
+typedef struct ElevatorMini ElevatorMini;
+
+typedef enum {
+    ELEVATOR_MINI_CABIN_CABIN_BUTTON_DC = 0,
+    ELEVATOR_MINI_CABIN_CABIN_BUTTON_DO = 1,
+    ELEVATOR_MINI_CABIN_CABIN_BUTTON_F1 = 2,
+    ELEVATOR_MINI_CABIN_CABIN_BUTTON_F2 = 3,
