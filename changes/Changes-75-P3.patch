+    ELEVATOR_MINI_MOTOR_ELEVATOR_MOTOR_SENSOR_D = 38,
+    ELEVATOR_MINI_MOTOR_ELEVATOR_MOTOR_SENSOR_U = 39,
+} ElevatorMini_In_BitPort;
+
+typedef enum {
+    ELEVATOR_MINI_CABIN_DOOR_OPEN = 0,
+    ELEVATOR_MINI_MOTOR_ELEVATOR_MOTOR_DOWN = 1,
+    ELEVATOR_MINI_MOTOR_ELEVATOR_MOTOR_STOP = 2,
+    ELEVATOR_MINI_MOTOR_ELEVATOR_MOTOR_UP = 3,
+} ElevatorMini_Out_BitPort;
+
+// NOTICE: Определение констант для модели Motor (ElevatorMini:Motor)
+/* Model Motor (ElevatorMini:Motor) */
+struct ElevatorMiniMotor {
+    // NOTICE: Определение переменных модели
+    enum {
+        ELEVATOR_MINI_MOTOR_INIT,
+        ELEVATOR_MINI_MOTOR_IDLE,
+        ELEVATOR_MINI_MOTOR_STOP,
+        ELEVATOR_MINI_MOTOR_DOWN,
