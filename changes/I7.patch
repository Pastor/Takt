+        let dir_str = dir.path().to_string_lossy().into_owned();
+
+        // Исходный файл с импортом
+        let src = r#"import "ping.but"; start Main;"#;
+        // Позиция 7 — символ '"' (начало строки импорта) — за пределами идентификатора
