+    }
+}
+
+/// Записывает имена из тела функции в соответствующие множества.
+fn usage_from_func(func: &FunctionDefinitionNode, set: &mut UsageSet) {
+    if let FunctionDefinitionNode::Local { body, .. } = func {
+        usage_from_stmt(body, set);
+    }
