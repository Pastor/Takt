+        ExpressionNode::ConditionalOperator(cond, then_e, else_e) => {
+            usage_from_expr(cond, set);
+            usage_from_expr(then_e, set);
+            usage_from_expr(else_e, set);
+        }
+        ExpressionNode::Array(items) | ExpressionNode::Initializer(items) => {
+            for item in items {
