// Скалярный `[bit;8]` (≤ 64 — упакованный скаляр, 0078): разряд 70 вне
// НОСИТЕЛЯ. Объявленной ширины у значения в этот момент нет — эталон говорит
// правду о носителе, а не догадывается об объявлении (граница фичи 0307).
//
// ⚠️ Разряд берётся у РЕЗУЛЬТАТА ВЫЗОВА: с фичи 0394 литеральный разряд за
// объявленной шириной отвергает семантика (`SE-125`), и до прогона дело не
// доходит. Тип результата вызова она не выводит — там и виден носитель.
var src: [bit; 8] := 0;

fn narrow() -> [bit; 8] {
    return src;
}

var n: u8 := 0;

out probe: u8 at 0;

start Run {
    always {
        n := n + 1;
        probe := narrow().70;
    }
    ref Run: n < 100;
}
