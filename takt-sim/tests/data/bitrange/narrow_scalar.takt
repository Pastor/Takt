// Скалярный `[bit;8]` (≤ 64 — упакованный скаляр, 0078): разряд 70 вне
// НОСИТЕЛЯ. Объявленной ширины у значения в этот момент нет — эталон говорит
// правду о носителе, а не догадывается об объявлении (граница фичи 0307).
var w: [bit; 8] := 0;
var n: u8 := 0;

out probe: u8 at 0;

start Run {
    always {
        n := n + 1;
        w.70 := 1;
        probe := n;
    }
    ref Run: n < 100;
}
