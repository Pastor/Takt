// Разряд ЗА пределами 128-разрядного значения `[bit;96]` (два слова, 0078).
//
// Прежде отказ говорил «вне диапазона 0..64» — ложь: разряд 70 тот же эталон
// исполняет (см. `wide_vector_ok.takt`).
//
// ⚠️ Разряд берётся у РЕЗУЛЬТАТА ВЫЗОВА, и это не стиль: с фичи 0394
// литеральный разряд за объявленной шириной отвергает семантика (`SE-125`) —
// до прогона. Тип результата вызова она не выводит и потому пропускает
// консервативно; там `SIM-011` и остаётся достижимым, а его текст —
// предметом этой проверки.
var src: [bit; 96] := 0;

fn wide() -> [bit; 96] {
    return src;
}

var n: u8 := 0;

out probe: u8 at 0;

start Run {
    always {
        n := n + 1;
        probe := wide().200;
    }
    ref Run: n < 100;
}
