// Сверка сдвига на величину, НЕ МЕНЬШУЮ ширины типа (фича 0334).
//
// `n = 8` при 8-битном значении: эталон даёт 0 для беззнакового и −1 для
// знакового (арифметический сдвиг оставляет знак), сдвиг влево даёт 0.
//
// Прежде цель `rust` печатала это оператором языка Rust, и один вход давал ТРИ
// разных ответа: паника в отладочной сборке, 200 в релизной (величина
// маскируется до `n & 7 = 0`) и 0 у эталона. Сдвиг влево на ЛИТЕРАЛЬНУЮ
// величину не собирался вовсе.
//
// ⚠️ `ctl` — контрольный вход: сдвиг на величину МЕНЬШЕ ширины, работавший
// всегда. Без него «стороны сошлись» значило бы лишь, что они одинаково
// исполняют исправленное.
var a: u8 := 200;
var b: i8 := -7;
var n: u8 := 8;
var m: u8 := 3;

var sr: u8 := 0;
var ss: i8 := 0;
var sl: u8 := 0;
var ctl: u8 := 0;

out o_sr: u8 at 0;
out o_ss: i8 at 1;
out o_sl: u8 at 2;
out o_ctl: u8 at 3;

start Run {
    always {
        sr := a >> n;
        ss := b >> n;
        sl := a << n;
        ctl := a >> m;
        o_sr := sr;
        o_ss := ss;
        o_sl := sl;
        o_ctl := ctl;
    }
    ref Run: ctl > 0;
}
