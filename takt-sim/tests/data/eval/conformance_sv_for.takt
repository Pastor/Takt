// Сверка РАЗВЁРНУТОГО цикла `for` цели `sv` с эталоном (фича 0321).
//
// До фичи цель отвергала любой `for` (`SV-002`) — в том числе такой, у
// которого границы известны при компиляции; остальные семь потребителей его
// исполняли.
//
// Тело НАКАПЛИВАЮЩЕЕ и зависит от переменной цикла: `acc := acc + k` даёт
// 0+1+2 = 3 за проход. На идемпотентном теле пропуск итерации и лишняя
// итерация были бы неразличимы (урок 0181-01).
var acc: u8 := 0;
var total: u8 := 0;
var i: u8 := 0;

out probe: u8 at 0;
out sum: u8 at 1;

start Run {
    always {
        i := i + 1;
        acc := 0;
        for var k: u8 := 0; k < 3; k := k + 1 {
            acc := acc + k;
        }
        total := total + acc;
        probe := acc;
        sum := total;
    }
    ref Run: i < 100;
}
