// Выдержка по времени внутри модели, реализующей состояние.
//
// `Heater` реализует состояние `Work` модели `Host`. Модельное время у дерева
// одно, и выдержка `after 5ms` внутри реализации обязана истечь так же, как в
// корневой модели: вход во внутреннее `W` на такте 2 (1 мс), срабатывание на
// 6 мс - такт 7, уход в `Done` по `next` - такт 8. Профиль "часы" (без `clock`):
// тестбенч ведёт время 1 мс на такт, как эталон.
model Heater {
    out h: u8;

    start W {
        enter { h := 1; }
        ref D: after 5ms;
    }

    state D {
        enter { h := 2; }
    }
}

model Host {
    out o: u8;

    start Idle {
        enter { o := 1; }
        ref Work;
    }

    state Work = Heater {
        next Done;
    }

    state Done {
        enter { o := 3; }
    }
}

start Main = Host;
