// Фикстура сверки табличной формы на последовательной композиции (фича 0438).
//
// Машина шагов остаётся в теле такта — она ведёт переходы ВНУТРИ состояния, —
// а наружу состояние уходит при одном условии: цепочка на последнем шаге и он
// завершён. Фаза каждого шага наблюдаема портом `probe`, поэтому пропуск шага,
// лишний такт и ранний выход дают разные трассы.
model First {
    out first_probe: u8;
    var n: u8 := 0;

    start Work {
        always {
            n := n + 1;
            first_probe := 10 + n;
        }
        ref Done: n = 2;
    }

    state Done;
}

model Second {
    out second_probe: u8;
    var m: u8 := 0;

    start Work {
        always {
            m := m + 1;
            second_probe := 20 + m;
        }
        ref Done: m = 2;
    }

    state Done;
}

model Line {
    out line_probe: u8;
    var k: u8 := 0;

    start Chain = First + Second {
        next Tail;
    }

    // Возврат в состояние-цепочку: второй проход обязателен. Без него страж
    // «цепочка на последнем шаге» неотличим от стража «последний шаг
    // завершён» — поля шага после первого прохода уже несут END, и пропуск
    // проверки шага увёл бы автомат из цепочки на первом же такте второго
    // прохода.
    state Tail {
        always {
            k := k + 1;
            line_probe := 90 + k;
        }
        ref Chain: k = 2;
    }
}

start Main = Line;
