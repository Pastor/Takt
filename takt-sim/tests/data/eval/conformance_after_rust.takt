// Фикстура сверки выдержки цели `rust` (фича 0134). Профиль «часы» (нет
// объявления `clock`): выдержка 5 мс через внешний источник `now_ms`. Результат
// выводится в порт `level` — наблюдать поля структуры нельзя (они приватны, как
// у прошивки), поэтому фикстура спроектирована с выходом.
model Dwell {
    out level: u8 at 0;

    start Waiting {
        ref Ready: after 5ms;
    }

    state Ready {
        enter { level := 1; }
    }
}

start Main = Dwell;
