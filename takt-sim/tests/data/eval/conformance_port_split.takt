// Порт СОСТАВНОГО типа: разворот на скалярные (фича 0390, Option C).
//
// Замер 2026-08-23: эталон исполняет, `st`, `sv` и `plantuml` переводят, а
// ПЯТЬ целей отказывают — `CC-015`, `ST-004`, `RS-016`, `SV-002`. Отказы
// объясняющие и сами называют обход: «Разложите порт на скалярные».
//
// Поля намеренно РАЗНЫЕ и меняются по тактам: перепутанный порядок листов
// даёт валидный вывод с другими значениями, и различает это только сверка.
struct Pair {
    lo: u8,
    hi: u8
}

out po: Pair at 0x100;
var n: u8 := 0;

start Run {
    always {
        n := n + 1;
        po := {n, n + 10};
    }
    ref Run;
}
