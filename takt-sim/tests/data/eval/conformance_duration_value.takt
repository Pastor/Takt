// Фикстура сверки ЗНАЧЕНИЙ типа `duration` (фича 0183): арифметика, сравнение и
// приведение к числу обязаны давать одно и то же у эталона и у порождённого кода.
//
// Проверяются НЕ такты срабатывания, а сами значения: представление эталона —
// наносекунды, представление целей — миллисекунды (ADR 0183), и это ровно та
// граница, на которой ошибка была бы молчаливой.
//
// Выход `ms` несёт число миллисекунд `left` — так значение видно и симулятору
// (через переменную), и харнессу цели (через порт).
model Timers {
    var pause: duration := 1s;
    var left: duration := 0s;

    out ms: u32 := 0;
    out late: bit := 0;

    start Counting {
        always {
            left := pause + 750ms;   // 1750 мс
            ms := left as u32;       // приведение бесплатно: единица та же
            late := (left > 500ms) ? 1 : 0;
        }
        ref Counting: false;
    }
}

start Main = Timers;
