// Наблюдение состояния СОСЕДА по композиции (фича 0397).
//
// Замер 2026-08-23: форму `S(Ping) = End` эталон исполняет, `c`/`c-hal` и
// `sv`/`sv-mmio` переводят, а `rust` отвечал `RS-020`, `st`/`st-at` — `ST-011`
// (под-модель видит только себя). Отказы объясняющие, расхождения значений не
// было: предмет — неполнота перевода.
//
// Наблюдаемое — `seen`: наблюдатель обязан войти в `Done` НА ТОМ ЖЕ такте, на
// котором сосед ушёл в `End` (правило 0245). Такт срабатывания и отличает
// верный разворот от «почти верного».
model Ping {
    var n: u8 := 0;

    start Go {
        always { n := n + 1; }
        ref End: n > 2;
    }

    state End { ref End; }
}

model Watch {
    var seen: u8 := 0;

    // Наблюдение идёт ПОРТОМ: поля порождённых структур цели `rust` приватны,
    // и трасса снимается через HAL — как в прочих сверках этой цели.
    out probe: u8 at 0;

    start Wait {
        always { probe := seen; }
        ref Done: S(Ping) = End;
    }

    state Done {
        always { seen := seen + 1; probe := seen; }
        ref Done;
    }
}

start Main = Ping | Watch;
