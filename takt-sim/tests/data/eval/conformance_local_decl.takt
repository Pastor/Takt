// Фикстура сверки ЛОКАЛЬНОГО объявления в теле блока (фича 0304).
//
// `var g := F + 1;` внутри `always { … }` — объявление без явного типа. До
// фичи вывод типов до тел не доходил, и один этот вход давал ТРИ разных
// ответа: эталон — `SIM-007` в такте, `c`/`c-hal`/`st`/`st-at`/`rust` —
// честный отказ, а `sv`/`sv-mmio` печатали невалидный модуль при НУЛЕВОМ коде
// возврата.
//
// ⚠️ Рядом стоит `top` — то же объявление на ВЕРХНЕМ уровне: контрольный вход,
// который работал всегда. Без него «стороны сошлись» значило бы лишь, что они
// одинаково исполняют исправленное, и не показывало бы, что предмет — именно
// тело блока.
//
// Тело накапливающее (`sum := sum + g;`): на идемпотентном теле пропуск и
// двойное исполнение неразличимы (урок 0181-01).
const F: u8 := 5;

var top := F + 1;
var sum: u8 := 0;

out probe: u8 at 0;
out mirror: u8 at 1;

start Run {
    always {
        var g := F + 1;
        sum := sum + g;
        probe := sum;
        mirror := top;
    }
    // Самопереход обязателен: состояние без переходов уходит в END после
    // первого такта (правило 0303), и накопление перестало бы наблюдаться —
    // сверка мерила бы завершение автомата, а не предмет фичи.
    ref Run: sum < 100;
}
