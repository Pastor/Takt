// Периодический блок `every` внутри модели, реализующей состояние.
//
// `Ticker` реализует состояние `Work` модели `Host`. Блок `every 2ms` обязан
// исполняться так же, как в корневой модели: счётчик растёт на 2, 4, 6 и 8 мс от
// входа во внутреннее `W` (такты 4, 6, 8, 10), на четвёртом срабатывании
// реализация уходит в `Stop`, и `next` уводит модель в `Done` на такте 11.
// Профиль "часы" (без `clock`): тестбенч ведёт время 1 мс на такт.
model Ticker {
    out t: u8;
    var n: u8 := 0;

    start W {
        every 2ms {
            n := n + 1;
            t := n;
        }
        ref Stop: n > 3;
    }

    state Stop;
}

model Host {
    out o: u8;

    start Idle {
        enter { o := 1; }
        ref Work;
    }

    state Work = Ticker {
        next Done;
    }

    state Done {
        enter { o := 3; }
    }
}

start Main = Host;
