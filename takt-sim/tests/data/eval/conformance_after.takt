// Фикстура сверки выдержки (фича 0134-04): выход из состояния через 5 мс при
// частоте 1 кГц, то есть через 5 тактов от входа. Проверяется НОМЕР ТАКТА
// срабатывания, а не факт перехода: расхождение на такт компилируется молча.
model Dwell {
    clock 1kHz;

    out done: bit := 0;

    start Waiting {
        ref Ready: after 5ms;
    }

    state Ready {
        enter { done := 1; }
    }
}

start Main = Dwell;
