{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo build:*)",
      "Bash(cargo doc:*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(cargo publish:*)",
      "Bash(cargo fmt -- --check && cargo fmt)",
      "Bash(git push --force)"
    ]
  }
}
